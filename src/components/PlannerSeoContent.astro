const FAQS: Array<{ q: string; a: string }> = tr({ es: FAQS_ES, en: FAQS_EN, de: FAQS_DE, fr: FAQS_FR, it: FAQS_IT, pt: FAQS_PT });

// ── JSON-LD: FAQPage + un TouristTrip por itinerario estático ────────────────
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const tripLds = itinerarios.map((it) => ({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: it.title,
  description: it.intro,
  touristType: tr({ es: "lujo tranquilo", en: "quiet luxury", de: "stiller Luxus", fr: "luxe tranquille", it: "lusso tranquillo", pt: "luxo tranquilo" }),
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
  itinerary: {
    "@type": "ItemList",
    itemListElement: it.days.map((d, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${d.label}${d.stops.length ? ` — ${d.stops.map((s) => s.name).join(" · ")}` : ""}`,
    })),
  },
}));

