  gastronomia: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v7a2.2 2.2 0 0 0 4.4 0V3"/><path d="M9.2 10.5V21"/><path d="M16.5 3c-1.4 1.2-2 3-2 5.2 0 1.5.7 2.4 2 2.6V21"/></svg>`,
  cultura: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5 12 5l8 4.5"/><path d="M6 10v7"/><path d="M10 10v7"/><path d="M14 10v7"/><path d="M18 10v7"/><path d="M4 19.5h16"/></svg>`,
