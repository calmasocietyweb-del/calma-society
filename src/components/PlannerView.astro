const privacyHref = privacyPath(locale);

const interestList = [
  ["calas", T.i_calas], ["gastronomia", T.i_gastro], ["cultura", T.i_cultura],
  ["naturaleza", T.i_nat], ["vida-nocturna", T.i_noche], ["nautica", T.i_naut], ["lujo-tranquilo", T.i_lujo],
];
const baseOptions = ["recomiendame", "ciutadella", "mao", "cala-galdana", "son-bou", "es-mercadal", "fornells"];
const kidAgeList = [["0-3", "0-3"], ["4-8", "4-8"], ["9-14", "9-14"], ["15+", "15+"]];

// Iconos de LÍNEA (SVG, stroke fino, currentColor) para las tarjetas del wizard.
// Nada de emojis — estética de lujo tranquilo (feedback de marca).
