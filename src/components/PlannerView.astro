/* ── Silueta de Menorca para el localizador de cada día ──────────────────────
   Solo 33 de los 141 lugares verificados tienen foto, así que la mayoría de los
   días se quedaban sin una sola imagen: paredes de texto gris (auditoría
   2026-08-11). En vez de rellenar con fotos prestadas —que sería mentir sobre
   dónde se ha hecho cada una—, cada día se sitúa en la isla de verdad: el
   contorno real de la costa (OpenStreetMap, ODbL) con las paradas del día en sus
   coordenadas. Es un dato honesto y, además, lo que de verdad quiere saber quien
   planifica: dónde cae hoy.

   El contorno completo son 596 vértices; para un dibujo de ~200 px se simplifica
   a ~110 (Douglas-Peucker) y así el island no engorda su payload. */
const RING = outline.ring as [number, number][];
const LAT_REF = (outline.bbox.latMin + outline.bbox.latMax) / 2;
const KX = Math.cos((LAT_REF * Math.PI) / 180);

/**
 * Douglas-Peucker sobre un anillo CERRADO. Aplicado tal cual, el algoritmo se
 * derrumba aquí: como el primer y el último vértice de la costa son el mismo
 * punto, la línea base mide cero, todas las distancias perpendiculares salen
 * nulas y la isla entera se reduce a 2 puntos (silueta invisible). Por eso el
 * anillo se parte primero por su vértice más lejano al de partida y se simplifica
 * cada mitad como una polilínea abierta.
 */
function simplifyOpen(pts: [number, number][], from: number, to: number, tol: number, keep: Uint8Array): void {
  const stack: [number, number][] = [[from, to]];
  while (stack.length) {
    const [a, b] = stack.pop()!;
    if (b - a < 2) continue;
    let far = -1;
    let best = tol;
    const [ax, ay] = pts[a];
    const [bx, by] = pts[b];
    const dx = bx - ax;
    const dy = by - ay;
    const len = Math.hypot(dx, dy) || 1;
    for (let i = a + 1; i < b; i++) {
      const d = Math.abs((pts[i][0] - ax) * dy - (pts[i][1] - ay) * dx) / len;
      if (d > best) { best = d; far = i; }
    }
    if (far > 0) { keep[far] = 1; stack.push([a, far], [far, b]); }
  }
}

function simplifyRing(pts: [number, number][], tol: number): [number, number][] {
  if (pts.length < 4) return pts;
  const last = pts.length - 1;
  let split = 1;
  let maxD = -1;
  for (let i = 1; i < last; i++) {
    const d = Math.hypot(pts[i][0] - pts[0][0], pts[i][1] - pts[0][1]);
    if (d > maxD) { maxD = d; split = i; }
  }
  const keep = new Uint8Array(pts.length);
  keep[0] = keep[split] = keep[last] = 1;
  simplifyOpen(pts, 0, split, tol, keep);
  simplifyOpen(pts, split, last, tol, keep);
  return pts.filter((_, i) => keep[i]);
}

const RING_XY = RING.map(([lng, lat]) => [lng * KX, lat] as [number, number]);
// Tolerancia calibrada para el tamaño al que se dibuja (~260 px de ancho): 179
// vértices (1,9 KB) conservan las calas reconocibles —Fornells, Maó, Addaia— sin
// cargar el island con los 596 originales.
const SIMPLE = simplifyRing(RING_XY, 0.003);
const MIN_X = Math.min(...SIMPLE.map((p) => p[0]));
const MAX_X = Math.max(...SIMPLE.map((p) => p[0]));
const MIN_Y = Math.min(...SIMPLE.map((p) => p[1]));
const MAX_Y = Math.max(...SIMPLE.map((p) => p[1]));
const MAP_W = 260;
const MAP_SCALE = MAP_W / (MAX_X - MIN_X);
const MAP_H = Math.round((MAX_Y - MIN_Y) * MAP_SCALE);
const ISLAND_PATH =
  "M" +
  SIMPLE.map(([x, y]) =>
    `${((x - MIN_X) * MAP_SCALE).toFixed(1)} ${((MAX_Y - y) * MAP_SCALE).toFixed(1)}`,
  ).join("L") +
  "Z";
/** Constantes de proyección que el island usa para colocar cada parada. */
const ISLAND = { path: ISLAND_PATH, w: MAP_W, h: MAP_H, kx: KX, minX: MIN_X, maxY: MAX_Y, s: MAP_SCALE };

