/**
 * Preguntas frecuentes de "Atardeceres y copas" (los seis idiomas activos).
 *
 * Una sola fuente para el FAQ VISIBLE y el JSON-LD `FAQPage` (sin duplicar
 * texto), igual que en "Cómo calculamos la calma". Respuestas concretas,
 * autocontenidas y con datos reales (incluidas valoraciones de Google) → es lo
 * que la IA cita (GEO, CLAUDE.md §8) y lo que posiciona la página.
 *
 * Las valoraciones se citan como referencia honesta y fechada; cambian con el
 * tiempo (ver la nota al pie de la herramienta).
 */
import JsonLd from "./JsonLd.astro";
import type { Locale } from "../config/site";
import { useTranslations } from "../i18n/ui";

/* Desde el 4-sep-2026 esta herramienta existe en los SEIS idiomas activos.
   Se sigue declarando en el tipo (en vez de dejar un ternario que caía a inglés
   en silencio) para que pasarle un idioma que aún no tenga textos sea un ERROR
   DE COMPILACIÓN, no una página alemana escrita en inglés. Al dar de alta un
   idioma nuevo se añade aquí y TypeScript señala todo lo que falta por rellenar
   (KAN-133). */
type ToolLocale = Extract<Locale, "es" | "en" | "fr" | "de" | "it" | "pt">;

interface Props {
  locale: ToolLocale;
}
const { locale } = Astro.props;

