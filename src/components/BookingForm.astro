---
/**
 * Formulario de reserva de transfers — ÚNICA copia del formulario.
 *
 * ⚠️ POR QUÉ ESTE COMPONENTE EXISTE (1-sep-2026). El formulario estaba escrito
 * ENTERO dentro de cada página de idioma: ~280 líneas duplicadas en `es` y otras
 * ~275 en `en`, con las cadenas incrustadas en el marcado. Al añadir francés y
 * alemán habrían sido CUATRO copias del mismo formulario — exactamente el patrón
 * que ese mismo día tumbó la build en `mdxComponents` (seis mapas de componentes
 * que habían derivado sin que nadie lo viera). Aquí el marcado vive una sola vez
 * y lo único que cambia por idioma son los textos.
 *
 * Los textos se declaran como `Record<BookingLocale, …>`: al desplegar la reserva
 * en un idioma nuevo, `astro check` enumera uno a uno los que faltan por traducir
 * (mismo criterio que `lib/bookings/catalog.ts`).
 */
import { VEHICLE_CATEGORIES, EXTRAS, type BookingLocale } from "../lib/bookings/catalog";

interface Props {
  locale: BookingLocale;
}
const { locale } = Astro.props;

const field =
  "mt-1 w-full rounded-lg border border-niebla bg-lino px-3.5 py-2.5 text-sm text-piedra placeholder:text-piedra-suave focus:border-terracota focus:outline-none";
const labelCls = "text-sm font-medium text-piedra";

/** Puntos de recogida sugeridos. Son topónimos: no se traducen. */
const puntos = [
  "Menorca (MAH)",
  "Maó",
  "Ciutadella",
  "Alaior",
  "Es Mercadal",
  "Es Castell",
  "Sant Lluís",
  "Ferreries",
  "Fornells",
  "Cala en Porter",
  "Son Bou",
  "Cala Galdana",
  "Punta Prima",
  "Binibeca",
  "Arenal d'en Castell",
  "Son Parc",
];

interface Textos {
  kicker: string;
  h1: string;
  intro: string;
  seals: [string, string];
  aeropuerto: string;
  puertoMao: string;
  puertoCiutadella: string;
  honeypot: string;
  paso1: string;
  origen: string;
  origenPh: string;
  destino: string;
  destinoPh: string;
  trayecto: string;
  soloIda: string;
  idaVuelta: string;
  fechaSalida: string;
  horaSalida: string;
  fechaRegreso: string;
  horaRegreso: string;
  soloIdaVuelta: string;
  vuelo: string;
  adultos: string;
  ninos: string;
  bebes: string;
  paso2: string;
  sinSorpresas: [string, string, string];
  precioAConfirmar: string;
  paso3: string;
  nombre: string;
  empresa: string;
  documento: string;
  email: string;
  telefono: string;
  direccion: string;
  codigoPostal: string;
  ciudad: string;
  pais: string;
  cupon: string;
  cuponNota: string;
  comentarios: string;
  comentariosPh: string;
  extras: string;
  optin: string;
  terminos: string;
  boton: string;
  letraPequena: string;
}

const T: Record<BookingLocale, Textos> = {
