---
/**
 * "A qué hora cae el sol" — tabla mes a mes de amanecer y atardecer en Menorca.
 *
 * Responde una pregunta real y muy buscada ("¿a qué hora se pone el sol en
 * Menorca en julio?") con un dato concreto, fechado y autocontenido: justo lo
 * que cita la IA (GEO, CLAUDE.md §8). Se calcula en build con `src/lib/sun.ts`
 * (cero JS de cliente) y NO caduca: es una tabla por meses, no un "hoy".
 *
 * Pensado para incrustarse en "Atardeceres y copas". El color nunca va solo.
 */
import { sunTimes, fmtMenorcaTime, dayLength, MENORCA } from "../lib/sun";
import type { Locale } from "../config/site";
import { INTL_LOCALE } from "../i18n/utils";

/* Tabla de la herramienta "Atardeceres y copas". Desde el 4-sep-2026 existe en
   los SEIS idiomas activos (el italiano y el portugués entraron con la
   traducción completa de la herramienta). Se sigue declarando con `Extract`
   —y no con `Locale` a secas— para que dar de alta un idioma nuevo sea un error
   de compilación en vez de una tabla servida en otro idioma (KAN-133). */
type ToolLocale = Extract<Locale, "es" | "en" | "fr" | "de" | "it" | "pt">;

interface Props {
  locale: ToolLocale;
}
const { locale } = Astro.props;

// Año de referencia = año de build. Las horas apenas cambian de un año a otro;
// usar el año en curso mantiene la tabla "actual" sin caducar (es por meses).
const now = new Date();
const YEAR = now.getFullYear();
const thisMonth = now.getMonth(); // 0-11, para resaltar el mes en curso

/* Los meses salen de `Intl`, no de tres listas escritas a mano (KAN-133). Antes
   había una escalera de ternarios que, con un idioma nuevo, servía la tabla en
   inglés sin avisar. Así cualquier idioma que se dé de alta trae sus meses
   correctos sin tocar este fichero. Se capitaliza la inicial porque son
   etiquetas de fila: `Intl` devuelve "enero"/"janvier" en minúscula. */
const mesLargo = new Intl.DateTimeFormat(INTL_LOCALE[locale], { month: "long", timeZone: "UTC" });
const months = Array.from({ length: 12 }, (_, i) => {
  const m = mesLargo.format(new Date(Date.UTC(2001, i, 15)));
  return m.charAt(0).toUpperCase() + m.slice(1);
});

// Una fila por mes, calculada para el día 15 (representativo del mes).
const rows = months.map((label, i) => {
  const ev = sunTimes(MENORCA.lat, MENORCA.lng, YEAR, i + 1, 15);
  return {
    i,
    label,
    rise: fmtMenorcaTime(ev.sunrise, locale),
    set: fmtMenorcaTime(ev.sunset, locale),
    len: dayLength(ev, locale),
  };
});

// "Key facts" calculados (sin hardcodear): el atardecer más temprano y el más
// tardío del año, para el resumen citable de cabecera.
const sets = rows.map((r) => r.set);
const earliestSet = sets.reduce((a, b) => (a < b ? a : b));
const latestSet = sets.reduce((a, b) => (a > b ? a : b));

const TT = {
  es: {
    eyebrow: "A qué hora cae el sol",
    title: "Amanecer y atardecer en Menorca, mes a mes",
    lead: `Casi todo en esta página gira en torno a una hora: la del atardecer. En Menorca el sol se pone alrededor de las ${latestSet} en pleno verano y tan pronto como las ${earliestSet} en lo más hondo del invierno. La hora dorada —esa luz cálida que lo vuelve todo más bonito— llega en los 30-40 minutos previos a la puesta: ese es el momento para tener ya la copa en la mano.`,
    colMonth: "Mes",
    colRise: "Amanece",
    colSet: "Atardece",
    colLen: "Luz",
    note: "Horas calculadas para el centro de Menorca, en hora local (CET/CEST, con su cambio de hora). La costa oeste (Ciutadella, Punta Nati) ve la puesta unos minutos más tarde; el este (Maó, Favàritx) ve el amanecer unos minutos antes. Llega siempre con margen: lo bueno empieza antes de que el sol toque el mar.",
    thisMonth: "Mes actual",
  },
  en: {
    eyebrow: "When the sun goes down",
    title: "Sunrise and sunset in Menorca, month by month",
    lead: `Almost everything on this page revolves around one time: sunset. In Menorca the sun sets around ${latestSet} at the height of summer and as early as ${earliestSet} in the depths of winter. The golden hour —that warm light that makes everything more beautiful— arrives in the 30-40 minutes before sundown: that's the moment to already have a drink in hand.`,
    colMonth: "Month",
    colRise: "Sunrise",
    colSet: "Sunset",
    colLen: "Daylight",
    note: "Times calculated for the centre of Menorca, in local time (CET/CEST, daylight saving included). The west coast (Ciutadella, Punta Nati) sees the sunset a few minutes later; the east (Maó, Favàritx) sees the sunrise a few minutes earlier. Always arrive with time to spare: the good part starts before the sun touches the sea.",
    thisMonth: "Current month",
  },
  fr: {
    eyebrow: "À quelle heure se couche le soleil",
    title: "Lever et coucher du soleil à Minorque, mois par mois",
    lead: `Presque tout sur cette page tourne autour d'une heure : celle du coucher de soleil. À Minorque, le soleil se couche vers ${latestSet} au plus fort de l'été et dès ${earliestSet} au plus profond de l'hiver. L'heure dorée —cette lumière chaude qui embellit tout— arrive dans les 30 à 40 minutes qui précèdent le coucher : c'est le moment où il faut déjà avoir le verre en main.`,
    colMonth: "Mois",
    colRise: "Lever",
    colSet: "Coucher",
    colLen: "Lumière",
    note: "Heures calculées pour le centre de Minorque, en heure locale (CET/CEST, changement d'heure inclus). La côte ouest (Ciutadella, Punta Nati) voit le coucher quelques minutes plus tard ; l'est (Maó, Favàritx) voit le lever quelques minutes plus tôt. Arrivez toujours avec de la marge : le meilleur commence avant que le soleil ne touche la mer.",
    thisMonth: "Mois en cours",
  },
  de: {
    eyebrow: "Wann die Sonne untergeht",
    title: "Sonnenauf- und -untergang auf Menorca, Monat für Monat",
    lead: `Fast alles auf dieser Seite dreht sich um eine einzige Uhrzeit: den Sonnenuntergang. Auf Menorca geht die Sonne im Hochsommer gegen ${latestSet} unter und im tiefsten Winter schon um ${earliestSet}. Die goldene Stunde — dieses warme Licht, das alles schöner macht — beginnt 30 bis 40 Minuten vor Sonnenuntergang: Dann sollten Sie das Glas bereits in der Hand halten.`,
    colMonth: "Monat",
    colRise: "Aufgang",
    colSet: "Untergang",
    colLen: "Tageslicht",
    note: "Zeiten berechnet für die Inselmitte, in Ortszeit (MEZ/MESZ, Sommerzeit inbegriffen). An der Westküste (Ciutadella, Punta Nati) geht die Sonne einige Minuten später unter; im Osten (Maó, Favàritx) geht sie einige Minuten früher auf. Kommen Sie immer mit Vorlauf: Das Schöne beginnt, bevor die Sonne das Meer berührt.",
    thisMonth: "Aktueller Monat",
  },
  it: {
    eyebrow: "A che ora tramonta il sole",
    title: "Alba e tramonto a Minorca, mese per mese",
    lead: `Quasi tutto in questa pagina ruota attorno a un'ora: quella del tramonto. A Minorca il sole cala verso le ${latestSet} nel pieno dell'estate e già alle ${earliestSet} nel cuore dell'inverno. L'ora d'oro —quella luce calda che rende tutto più bello— arriva nei 30-40 minuti precedenti: è il momento in cui conviene avere già il bicchiere in mano.`,
    colMonth: "Mese",
    colRise: "Alba",
    colSet: "Tramonto",
    colLen: "Luce",
    note: "Orari calcolati per il centro di Minorca, in ora locale (CET/CEST, cambio dell'ora incluso). La costa ovest (Ciutadella, Punta Nati) vede il tramonto qualche minuto più tardi; l'est (Maó, Favàritx) vede l'alba qualche minuto prima. Arrivi sempre con un po' di margine: il bello comincia prima che il sole tocchi il mare.",
    thisMonth: "Mese in corso",
  },
  pt: {
    eyebrow: "A que horas se põe o sol",
    title: "Nascer e pôr do sol em Menorca, mês a mês",
    lead: `Quase tudo nesta página gira à volta de uma hora: a do pôr do sol. Em Menorca o sol põe-se por volta das ${latestSet} em pleno verão e já às ${earliestSet} no mais fundo do inverno. A hora dourada —aquela luz quente que torna tudo mais bonito— chega nos 30 a 40 minutos anteriores: é o momento de já ter o copo na mão.`,
    colMonth: "Mês",
    colRise: "Nascer",
    colSet: "Pôr do sol",
    colLen: "Luz",
    note: "Horas calculadas para o centro de Menorca, em hora local (CET/CEST, mudança de hora incluída). A costa oeste (Ciutadella, Punta Nati) vê o pôr do sol alguns minutos mais tarde; o leste (Maó, Favàritx) vê o nascer do sol alguns minutos antes. Chegue sempre com folga: o melhor começa antes de o sol tocar o mar.",
    thisMonth: "Mês atual",
  },
};
const T = TT[locale];
---

<section class="mx-auto max-w-prosa px-5 sm:px-8">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-oro">{T.eyebrow}</p>
  <h2 class="mt-2 font-display text-2xl text-tinta sm:text-[1.7rem]">{T.title}</h2>
  <p class="mt-4 text-base leading-relaxed text-piedra-suave">{T.lead}</p>

  <div class="mt-6 overflow-hidden rounded-2xl border border-niebla">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-arena/50 text-left">
          <th scope="col" class="px-3 py-2.5 font-semibold text-piedra sm:px-4">{T.colMonth}</th>
          <th scope="col" class="px-3 py-2.5 text-right font-semibold text-piedra sm:px-4">{T.colRise}</th>
          <th scope="col" class="px-3 py-2.5 text-right font-semibold text-piedra sm:px-4">{T.colSet}</th>
          <th scope="col" class="hidden px-3 py-2.5 text-right font-semibold text-piedra sm:table-cell sm:px-4">{T.colLen}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr
              class:list={[
                "border-t border-niebla/70",
                r.i === thisMonth ? "bg-oro-vivo/10" : "odd:bg-lino even:bg-arena/20",
              ]}
            >
              <th scope="row" class="px-3 py-2 text-left font-normal text-tinta sm:px-4">
                {r.label}
                {r.i === thisMonth && (
                  <span class="ml-2 rounded-full bg-oro-vivo/20 px-2 py-0.5 align-middle text-[0.62rem] font-semibold uppercase tracking-wide text-oro">
                    {T.thisMonth}
                  </span>
                )}
              </th>
              <td class="px-3 py-2 text-right tabular-nums text-piedra-suave sm:px-4">↑ {r.rise}</td>
              <td class="px-3 py-2 text-right tabular-nums font-semibold text-arcilla sm:px-4">↓ {r.set}</td>
              <td class="hidden px-3 py-2 text-right tabular-nums text-piedra-suave sm:table-cell sm:px-4">{r.len}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-piedra-suave">{T.note}</p>
</section>
