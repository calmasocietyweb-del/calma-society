import MenorcaBusCTA from "./MenorcaBusCTA.astro";
import { srcset } from "../lib/img";
import type { Locale } from "../config/site";

/* Las páginas de escala existen ya en los SEIS idiomas. Con `locale: Locale`, un
   idioma nuevo caía al inglés en los 13 sitios donde decidía `isEs` —incluido el
   formato de fechas— sin dar un aviso. Declarado, es error de compilación (KAN-133). */
type ToolLocale = Extract<Locale, "es" | "en" | "fr" | "de" | "it" | "pt">;

interface Props {
  barco: Barco;
  locale: ToolLocale;
  /** Cuándo se actualizó el calendario y qué cobertura tiene (honestidad). */
  fuente: { updated: string; coveragePct: number; officialSource: string };
}
const { barco: b, locale, fuente } = Astro.props;

/* Registro por idioma: `isEs ? español : inglés` mandaba al alemán al inglés
   en los 13 sitios donde decidía (KAN-134). */
const tr = <T,>(m: Record<ToolLocale, T>): T => m[locale];

