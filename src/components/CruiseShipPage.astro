const T = TEXTOS[locale];

const fmtFecha = (iso: string) => {
  const [y, m, d] = iso.split("-").map(Number);
  return new Intl.DateTimeFormat(tr({ es: "es-ES", en: "en-GB", fr: "fr-FR", de: "de-DE", it: "it-IT", pt: "pt-PT" }), { day: "numeric", month: "long", timeZone: "UTC" }).format(
    new Date(Date.UTC(y, m - 1, d)),
  );
};
const hoy = new Date().toISOString().slice(0, 10);
const proximas = b.fechas.filter((f) => f >= hoy);

// Foto del muelle (2026-07-17, flota esperando una escala real). Límite de
// honestidad: la escala fotografiada es la del AIDAstella, así que SOLO su
// página puede decir «tu coche esperando a tu barco» (y lleva la vertical con
// el barco entero). El resto de barcos recibe un encuadre donde el casco del
// fondo es anónimo y el pie habla solo del muelle — que es la verdad.
const esAidastella = b.slug === "aidastella";
const foto = esAidastella
  ? { src: "/uploads/mb-flota-aidastella.webp", w: 1600, h: 2400, aspect: "aspect-[2/3]", alt: T.fotoAltAida, pie: T.fotoPieAida }
  : { src: "/uploads/mb-flota-muelle.webp", w: 1600, h: 1066, aspect: "aspect-[3/2]", alt: T.fotoAlt, pie: T.fotoPie };

const calendarioHref = tr({ es: "/articulo/cruceros-en-menorca-2026", en: "/en/article/cruises-in-menorca-2026", fr: "/fr/article/escale-croisiere-mao-minorque", de: "/de/artikel/kreuzfahrten-menorca-2026", it: "/it/articolo/crociere-a-minorca-2026", pt: "/pt/artigo/cruzeiros-em-menorca-2026" });

/* El tipo admite `null` = «esa herramienta aún no tiene página en ese idioma», y
   entonces la tarjeta no se pinta. Hoy las cuatro existen en los seis idiomas
   (verificado contra `src/pages/`, no supuesto: componer una URL no es que exista),
   pero el hueco declarado evita que el próximo mercado enlace a un 404. */
const enlaces = [
  { href: tr<string | null>({ es: "/planificador", en: "/en/trip-planner", fr: "/fr/planificateur", de: "/de/reiseplaner", it: "/it/pianificatore-di-viaggio", pt: "/pt/planeador-de-viagem" }), t: T.planificador, d: T.planificadorTxt },
  { href: tr<string | null>({ es: "/donde-el-mar-esta-en-calma", en: "/en/where-the-sea-is-calm", fr: "/fr/ou-la-mer-est-calme", de: "/de/wo-das-meer-ruhig-ist", it: "/it/dove-il-mare-e-calmo", pt: "/pt/onde-o-mar-esta-calmo" }), t: T.marEnCalma, d: T.marEnCalmaTxt },
  // Solo si sus horas lo permiten: no se ofrece un atardecer a quien zarpa a las cuatro.
  ...(b.llegaAlAtardecer
    ? [{ href: tr<string | null>({ es: "/atardeceres-y-copas", en: "/en/sunsets-and-drinks", fr: "/fr/couchers-et-cocktails", de: "/de/sonnenuntergaenge-und-drinks", it: "/it/tramonti-e-cocktail", pt: "/pt/pores-do-sol-e-copos" }), t: T.atardeceres, d: T.atardeceresTxt }]
    : []),
  // La portada de sección (src/config/sections.ts), también en los seis idiomas.
  ...(b.daParaCenar ? [{ href: tr<string | null>({ es: "/comer-y-beber", en: "/en/eat-and-drink", fr: "/fr/manger-et-boire", de: "/de/essen-und-trinken", it: "/it/mangiare-e-bere", pt: "/pt/comer-e-beber" }), t: T.comer, d: T.comerTxt }] : []),
].filter((e): e is { href: string; t: string; d: string } => e.href !== null);
---

<div class="mx-auto max-w-prosa px-5 pt-12 sm:px-8 sm:pt-16">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">{T.kicker}</p>
  <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">{b.ship}</h1>
  <p class="lead mt-5">
    {tr({
      es: `El ${b.ship} (${b.line}) atraca en Maó a las ${b.arrival} y zarpa a las ${b.departure}. Descontando el desembarque y el margen de vuelta, te quedan unas ${enHoras(b.utilesMin, "es")} de verdad en tierra. Esto es lo que da de sí ese tiempo — y lo que no.`,
      en: `The ${b.ship} (${b.line}) berths in Maó at ${b.arrival} and sails at ${b.departure}. Once you take off disembarking and the margin to get back, you have around ${enHoras(b.utilesMin, "en")} truly ashore. Here is what that time is good for — and what it isn't.`,
      fr: `Le ${b.ship} (${b.line}) accoste à Maó à ${b.arrival} et appareille à ${b.departure}. Une fois retranchés le débarquement et la marge de retour, il vous reste environ ${enHoras(b.utilesMin, "fr")} vraiment à terre. Voici ce que ce temps permet — et ce qu'il ne permet pas.`,
      de: `Die ${b.ship} (${b.line}) legt in Mahón um ${b.arrival} an und läuft um ${b.departure} wieder aus. Nach Abzug des Ausschiffens und des Puffers für den Rückweg bleiben Ihnen rund ${enHoras(b.utilesMin, "de")} echte Zeit an Land. Das ist es, was diese Zeit hergibt — und was nicht.`,
      it: `La ${b.ship} (${b.line}) attracca a Maó alle ${b.arrival} e salpa alle ${b.departure}. Tolti lo sbarco e il margine per il ritorno, le restano circa ${enHoras(b.utilesMin, "it")} davvero a terra. Ecco cosa rende quel tempo — e cosa no.`,
      pt: `O ${b.ship} (${b.line}) atraca em Maó às ${b.arrival} e zarpa às ${b.departure}. Descontando o desembarque e a margem de regresso, sobram-lhe cerca de ${enHoras(b.utilesMin, "pt")} realmente em terra. Isto é o que esse tempo dá de si — e o que não dá.`,
    })}
  </p>
</div>

<section class="mx-auto mt-10 max-w-prosa px-5 sm:px-8">
  {/* ── Las horas, en grande: es el dato que busca ── */}
  <div class="rounded-2xl border border-niebla bg-arena/40 p-5 sm:p-6">
    <h2 class="font-display text-2xl text-tinta">{T.horario}</h2>
    <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div>
        <dt class="text-xs uppercase tracking-wider text-piedra-suave">{T.atraca}</dt>
        <dd class="font-display text-2xl text-tinta">{b.arrival}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-piedra-suave">{T.zarpa}</dt>
        <dd class="font-display text-2xl text-tinta">{b.departure}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-piedra-suave">{T.escala}</dt>
        <dd class="font-display text-2xl text-piedra">{enHoras(b.escalaMin, locale)}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-oro">{T.utiles}</dt>
        <dd class="font-display text-2xl text-arcilla">{enHoras(b.utilesMin, locale)}</dd>
      </div>
    </dl>
    <details class="mt-4 border-t border-niebla pt-3">
      <summary class="cursor-pointer text-sm font-medium text-arcilla">{T.comoSale}</summary>
      <p class="mt-2 text-sm leading-relaxed text-piedra-suave">{T.cuenta}</p>
    </details>
  </div>

  {/* ── Avisos que dependen de ESTE barco ── */}
  <div class="mt-5 space-y-3">
    {b.desembarcoMasivo && (
      <div class="rounded-xl border border-terracota/40 bg-lino p-4">
        <p class="font-display text-lg text-tinta">{T.masivo}</p>
        <p class="mt-1 text-sm leading-relaxed text-piedra">{T.masivoTxt}</p>
      </div>
    )}
    {b.soloManana && (
      <div class="rounded-xl border border-niebla bg-lino p-4">
        <p class="font-display text-lg text-tinta">{T.manana}</p>
        <p class="mt-1 text-sm leading-relaxed text-piedra">{T.mananaTxt}</p>
      </div>
    )}
    {b.llegaAlAtardecer && (
      <div class="rounded-xl border border-oro-vivo/40 bg-crema/40 p-4">
        <p class="font-display text-lg text-tinta">{T.atardecer}</p>
        <p class="mt-1 text-sm leading-relaxed text-piedra">{T.atardecerTxt}</p>
      </div>
    )}
    {b.daParaCenar && (
      <div class="rounded-xl border border-oro-vivo/40 bg-crema/40 p-4">
        <p class="font-display text-lg text-tinta">{T.cena}</p>
        <p class="mt-1 text-sm leading-relaxed text-piedra">{T.cenaTxt}</p>
      </div>
    )}
  </div>

  {/* ── Lo que cabe ── */}
  <h2 class="mt-10 font-display text-2xl text-tinta">{T.cabe}</h2>
  <ol class="mt-4 space-y-3">
    {b.caben.map((p) => (
      <li class="rounded-xl border border-niebla bg-lino p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-display text-lg text-tinta">{tr({ es: p.es, en: p.en, fr: p.fr, de: p.de, it: p.it, pt: p.pt })}</h3>
          <span class={`text-xs font-semibold ${vaJusto(p, b.utilesMin) ? "text-terracota" : "text-piedra-suave"}`}>
            {vaJusto(p, b.utilesMin)
              ? T.justo
              : `${T.margen} ${enHoras(margenDe(p, b.utilesMin), locale)}`}
          </span>
        </div>
        <p class="mt-1 text-sm leading-relaxed text-piedra-suave">{tr({ es: p.detalleEs, en: p.detalleEn, fr: p.detalleFr, de: p.detalleDe, it: p.detalleIt, pt: p.detallePt })}</p>
      </li>
    ))}
  </ol>

  {/* ── Lo que NO cabe: el moat ── */}
  {b.noCaben.length > 0 && (
    <>
      <h2 class="mt-10 font-display text-2xl text-tinta">{T.noCabe}</h2>
      <p class="mt-2 text-sm text-piedra-suave">{T.noCabeIntro}</p>
      <ul class="mt-3 space-y-2">
        {b.noCaben.map((p) => (
          <li class="rounded-xl border border-niebla bg-arena/40 p-4">
            <p class="font-medium text-tinta">{tr({ es: p.es, en: p.en, fr: p.fr, de: p.de, it: p.it, pt: p.pt })}</p>
            <p class="mt-1 text-sm leading-relaxed text-piedra-suave">{tr({ es: p.detalleEs, en: p.detalleEn, fr: p.detalleFr, de: p.detalleDe, it: p.detalleIt, pt: p.detallePt })}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {/* ── El chófer: el producto real (chófer por horas + traslado) ── */}
  {/* La foto ancla el servicio EN el puerto de Maó: es el coche esperando donde
      atraca este barco, no un render de catálogo. Va justo antes del CTA porque
      es lo que hace creíble la promesa de «te esperamos en el muelle». */}
  <figure class="mt-10">
    <img
      src={foto.src}
      srcset={srcset(foto.src)}
      sizes="(min-width: 700px) 672px, 100vw"
      alt={foto.alt}
      width={foto.w}
      height={foto.h}
      loading="lazy"
      decoding="async"
      class={`${foto.aspect} w-full rounded-xl object-cover`}
    />
    <figcaption class="mt-2 text-xs text-piedra-suave">{foto.pie}</figcaption>
  </figure>
  <div class="mt-6">
    <MenorcaBusCTA lang={locale} title={T.busTitle} text={T.busText} cta={T.busCta} />
  </div>

  {/* ── Sus fechas ── */}
  <h2 class="mt-10 font-display text-2xl text-tinta">{T.fechas}</h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {b.fechas.map((f) => (
      <li
        class={`rounded-full border px-3 py-1 text-sm ${
          f >= hoy ? "border-arcilla text-arcilla" : "border-niebla text-piedra-suave line-through"
        }`}
      >
        {fmtFecha(f)}
      </li>
    ))}
  </ul>
  <p class="mt-2 text-xs text-piedra-suave">
    {T.fechasNota} · <a class="underline decoration-niebla underline-offset-2 hover:text-terracota" href={calendarioHref}>{T.verCalendario} →</a>
  </p>

  {/* ── Honestidad: esto puede cambiar ── */}
  <div class="mt-6 rounded-xl border border-niebla bg-arena/40 p-4">
    <p class="text-xs font-semibold uppercase tracking-wider text-oro">{T.aviso}</p>
    <p class="mt-1 text-sm leading-relaxed text-piedra-suave">
      {T.avisoTxt.replace("{fecha}", fmtFecha(fuente.updated)).replace("{cobertura}", String(fuente.coveragePct))}
    </p>
  </div>

  {/* ── Enlaces a la casa (los que sus horas Y su idioma permiten) ── */}
  {/* La lista puede quedar vacía si un idioma no tiene aún esas herramientas, y un
      titular sin nada debajo es peor que no ponerlo. */}
  {enlaces.length > 0 && (
    <>
      <h2 class="mt-10 font-display text-2xl text-tinta">{T.sigue}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {enlaces.map((e) => (
          <a
            href={e.href}
            class="rounded-xl border border-niebla bg-lino p-4 transition-colors hover:border-arcilla"
            data-umami-event="crucero-enlace-interno"
          >
            <p class="font-display text-lg text-tinta">{e.t}</p>
            <p class="mt-1 text-sm text-piedra-suave">{e.d}</p>
          </a>
        ))}
      </div>
    </>
  )}
</section>
