const t = T[lang] ?? T.es;

/** Un idioma por clave: si falta uno, el compilador lo canta. */
type PorIdioma = Record<LangFlota, string>;

interface Coche {
  nombre: string;
  para: PorIdioma;
  linea: PorIdioma;
  img: string;
  alt: PorIdioma;
  /** Artículo propio en la revista; si falta, la tarjeta sale a Menorca Bus. */
  href?: PorIdioma;
  /** Identifica la tarjeta en el UTM → sabemos QUÉ coche se clica. */
  slug: string;
}

