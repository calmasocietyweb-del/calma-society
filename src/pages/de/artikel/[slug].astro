---
// Artikel auf Deutsch: /de/artikel/[slug]
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { articleSlugFor } from "../../../lib/content";
import { articleUrl, homePath } from "../../../i18n/utils";
// Componentes que el cuerpo MDX puede usar (inyectados, como en es/en/fr).
import Figure from "../../../components/Figure.astro";
import MenorcaBusCTA from "../../../components/MenorcaBusCTA.astro";
import CruceroCalendar from "../../../components/CruceroCalendar.astro";
import FlotaChofer from "../../../components/FlotaChofer.astro";
import ToolsCTA from "../../../components/ToolsCTA.astro";

const mdxComponents = { Figure, MenorcaBusCTA, CruceroCalendar, FlotaChofer, ToolsCTA };

export async function getStaticPaths() {
  const arts = await getCollection(
    "articulos",
    (e) => e.data.lang === "de" && e.data.status === "published",
  );
  return arts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const author = await getEntry(entry.data.author);
const relatedPlaces = entry.data.relatedPlaces
  ? await Promise.all(entry.data.relatedPlaces.map((ref) => getEntry(ref)))
  : [];

const esSlug = await articleSlugFor(entry.data.translationKey, "es");
const enSlug = await articleSlugFor(entry.data.translationKey, "en");
const frSlug = await articleSlugFor(entry.data.translationKey, "fr");
const itSlug = await articleSlugFor(entry.data.translationKey, "it");
const ptSlug = await articleSlugFor(entry.data.translationKey, "pt");
const alternates = {
  de: articleUrl("de", entry.id),
  es: esSlug ? articleUrl("es", esSlug) : homePath("es"),
  en: enSlug ? articleUrl("en", enSlug) : homePath("en"),
  ...(frSlug ? { fr: articleUrl("fr", frSlug) } : {}),
  ...(itSlug ? { it: articleUrl("it", itSlug) } : {}),
  ...(ptSlug ? { pt: articleUrl("pt", ptSlug) } : {}),
};
---

<ArticleLayout entry={entry} author={author} relatedPlaces={relatedPlaces} alternates={alternates}>
  <Content components={mdxComponents} />
</ArticleLayout>
