---
// Impressum (DE). Base revisable; datos de SITE.company.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const c = SITE.company;
const cif = c.cif || "[Steuernummer folgt]";
const address = c.address || "[Anschrift folgt]";
const alternates = {
  es: "/aviso-legal",
  en: "/en/legal-notice",
  fr: "/fr/mentions-legales",
  de: "/de/impressum", it: "/it/note-legali",
  pt: "/pt/aviso-legal",
};
---

<BaseLayout title="Impressum" description="Impressum von Calma Society." locale="de" alternates={alternates}>
  <article class="mx-auto max-w-prosa px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">Rechtliches</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">Impressum</h1>
    <p class="mt-2 text-sm text-piedra-suave">Zuletzt aktualisiert: Juni 2026</p>

    <div class="article-body mt-8">
      <h2>1. Betreiber der Website</h2>
      <p>
        Diese Website (<strong>{SITE.name}</strong>, erreichbar unter {SITE.url.replace("https://", "")})
        wird herausgegeben und betrieben von:
      </p>
      <ul>
        <li><strong>Betreiber:</strong> {c.legalName}</li>
        <li><strong>Steuernummer (CIF):</strong> {cif}</li>
        <li><strong>Sitz:</strong> {address}</li>
        <li><strong>Verantwortlich:</strong> {c.responsible}</li>
        <li><strong>E-Mail:</strong> {c.email}</li>
        <li><strong>Telefon:</strong> {c.phone}</li>
      </ul>

      <h2>2. Zweck</h2>
      <p>
        {SITE.name} ist eine digitale redaktionelle Publikation über Menorca und das
        Mittelmeer. Mit dem Zugriff auf die Website und ihrer Nutzung erklären Sie sich mit
        diesen Hinweisen einverstanden.
      </p>

      <h2>3. Nutzungsbedingungen</h2>
      <p>
        Die Nutzerinnen und Nutzer verpflichten sich, die Inhalte sachgerecht zu verwenden
        und sie weder für rechtswidrige Zwecke noch in einer Weise zu nutzen, die Rechte
        Dritter oder des Betreibers verletzt.
      </p>

      <h2>4. Geistiges Eigentum</h2>
      <p>
        Die Inhalte (Texte, Fotografien, Gestaltung, Logos und Marke) gehören
        {c.legalName} oder ihren Urhebern und sind urheberrechtlich geschützt.
        Jede Vervielfältigung, Verbreitung oder Bearbeitung ohne ausdrückliche Genehmigung
        ist untersagt.
      </p>

      <h2>5. Haftung</h2>
      <p>
        Der Betreiber haftet weder für eine unsachgemäße Nutzung der Website noch für
        Schäden, die aus ihrer Nutzung entstehen. Wir bemühen uns um richtige und aktuelle
        Informationen, können jedoch weder Fehlerfreiheit noch eine ununterbrochene
        Verfügbarkeit garantieren.
      </p>

      <h2>6. Links zu Dritten</h2>
      <p>
        Die Website kann Links zu Seiten Dritter enthalten (einschließlich klar
        gekennzeichneter Affiliate- oder Partner-Links). Der Betreiber ist für deren Inhalte
        und Richtlinien nicht verantwortlich.
      </p>

      <h2>7. Anwendbares Recht</h2>
      <p>
        Diese Hinweise unterliegen spanischem Recht; zuständig sind die Gerichte, die das
        anwendbare Recht bestimmt.
      </p>

      <p>Siehe auch unsere <a href="/de/datenschutz">Datenschutzerklärung</a> und unsere <a href="/de/cookies">Cookie-Richtlinie</a>.</p>
    </div>
  </article>
</BaseLayout>
