---
// Rubrikseiten auf Deutsch: /de/entdecken, /de/veranstaltungen, /de/essen-und-trinken, …
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionView from "../../components/SectionView.astro";
import { SECTIONS, getSection } from "../../config/sections";

export async function getStaticPaths() {
  return SECTIONS.map((s) => ({
    params: { section: s.href.de.replace(/^\/de\//, "") },
    props: { key: s.key },
  }));
}

const { key } = Astro.props;
const section = getSection(key)!;
const alternates = {
  es: section.href.es,
  en: section.href.en,
  fr: section.href.fr,
  de: section.href.de,
};
---

<BaseLayout
  title={section.seoTitle?.de ?? section.label.de}
  description={section.seoDescription?.de ?? section.intro.de}
  locale="de"
  alternates={alternates}
>
  <SectionView sectionKey={key} locale="de" />
</BaseLayout>
