---
/**
 * Índice del panel de gestión (KAN-122; una sola URL para todo lo interno).
 * Página ESTÁTICA y sin secretos: se prerenderiza en los dos despliegues.
 * Los paneles con datos (socios, analítica, reservas) solo funcionan en el
 * despliegue de edición (Vercel) y cada uno lo explica si se abre donde no
 * toca. `noindex` + excluida del sitemap (regla /panel/).
 *
 * Interfaz: sistema "libro de cuentas" (src/styles/panel.css), separado de
 * la marca — esto es el back-office, no la revista.
 */
import "../../styles/panel.css";

/**
 * ¿Se ha compilado Keystatic en ESTE despliegue? Misma condición que
 * `cmsEnabled` en `astro.config.ts`. En la web pública (Cloudflare) el CMS no
 * se compila, así que `/keystatic` devolvía 404: era el único enlace interno
 * roto del sitio (KAN-127). Ahora la tarjeta explica dónde se abre en vez de
 * prometer una página que no existe.
 */
const cmsDisponible =
  !!process.env.VERCEL ||
  process.env.KEYSTATIC === "true" ||
  ["dev", "start", "cms"].includes(process.env.npm_lifecycle_event ?? "");

const HERRAMIENTAS = [
  {
    href: "/panel/socios",
    titulo: "Socios y dinero",
    texto: "El registro del dinero: socios, tratos, cobros y valor entregado.",
  },
  {
    href: "/panel/analitica",
    titulo: "Analítica",
    texto: "Espejo de Umami: tráfico, herramientas y clics por colaborador.",
  },
  {
    href: cmsDisponible ? "/keystatic" : null,
    titulo: "Editor de artículos",
    texto: cmsDisponible
      ? "Keystatic: crear y aprobar contenido de la revista sin tocar código."
      : "Keystatic solo se compila en el despliegue de edición (Vercel). Ábrelo desde ahí.",
  },
  {
    href: "/panel/reservas",
    titulo: "Reservas de transfers",
    texto: "Solicitudes de traslado y su estado. Apagado hasta la API de Menorca Bus.",
  },
];

const EXTERNOS = [
  { href: "https://cloud.umami.is", label: "Umami" },
  { href: "https://dashboard.mailerlite.com", label: "MailerLite" },
  { href: "https://search.google.com/search-console", label: "Search Console" },
  { href: "https://calmasocietyweb.atlassian.net/jira/software/projects/KAN/boards/1", label: "Jira" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel de gestión — Calma Society</title>
  </head>
  <body class="bo">
    <header class="bo-topbar">
      <a class="bo-brand" href="/panel/" aria-current="page">Gestión<small>Calma Society</small></a>
      <nav class="bo-topnav" aria-label="Secciones del panel">
        <a href="/panel/socios">Socios y dinero</a>
        <a href="/panel/analitica">Analítica</a>
        <a href="/panel/reservas">Reservas</a>
      </nav>
    </header>

    <main class="bo-wrap">
      <h1 class="bo-h1">Panel de gestión</h1>
      <p class="bo-note" style="margin:0;">
        Una sola puerta para todo lo interno. Los paneles con datos se abren desde el despliegue
        de edición, con usuario y contraseña.
      </p>

      <nav class="bo-idx" aria-label="Herramientas internas">
        {
          HERRAMIENTAS.map((t) =>
            t.href ? (
              <a href={t.href} class="bo-card">
                <h2>{t.titulo}</h2>
                <p>{t.texto}</p>
              </a>
            ) : (
              /* Sin destino en este despliegue: se muestra como ficha apagada,
                 no como enlace, para no prometer un clic que da 404. */
              <div class="bo-card bo-card--apagada">
                <h2>{t.titulo}</h2>
                <p>{t.texto}</p>
              </div>
            ),
          )
        }
      </nav>

      <section class="bo-card" aria-labelledby="externos">
        <div class="bo-h"><h2 id="externos">Cuentas externas</h2></div>
        <ul class="bo-lista">
          {
            EXTERNOS.map((e) => (
              <li>
                <a href={e.href} target="_blank" rel="noopener">{e.label} ↗</a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
