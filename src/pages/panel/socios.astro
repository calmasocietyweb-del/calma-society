---
/**
 * Panel de socios y dinero (KAN-122) — el registro interno del dinero.
 *
 * - SSR SOLO en Vercel (lo decide astro.config.ts → panel-ssr-en-vercel);
 *   en Cloudflare/local se prerenderiza un aviso estático sin secretos.
 * - Basic auth con PANEL_USER / PANEL_PASS (las mismas del resto del panel).
 * - Lee y escribe contra la API del Worker (workers.dev) con la clave
 *   SOCIOS_ADMIN_KEY (variable en Vercel). Formularios POST-redirect-GET.
 * - Responde a tres preguntas, en este orden: ¿cuánto ha entrado? ·
 *   ¿quién nos debe qué? · ¿qué valor entregamos este mes?
 *
 * Interfaz: sistema "libro de cuentas" (src/styles/panel.css), deliberadamente
 * SEPARADO de la marca — es un programa de gestión interno, no la revista.
 *
 * Regla de oro (no mezclar): los COBROS son dinero recibido y los escribe el
 * dueño; la MEDICIÓN mensual es valor entregado y se calcula sola.
 */
import "../../styles/panel.css";
import {
  LABELS,
  ESTADOS_SOCIO,
  MODELOS_TRATO,
  ETIQUETADOS,
} from "../../lib/socios/catalog";
import { formatEuros, parseEuros, mesLabel, mesAnterior } from "../../lib/socios/money";
import {
  resumenDinero,
  curvaMensual,
  avisos,
  filasSocios,
  type SocioRow,
  type TratoRow,
  type CobroRow,
  type MedicionRow,
} from "../../lib/socios/resumen";

const onVercel = !!process.env.VERCEL;

// Página con autenticación y datos: PROHIBIDO que el edge la cachee (el
// adaptador emite public,max-age=0 por defecto y Vercel llegó a servir un HIT).
if (onVercel) Astro.response.headers.set("cache-control", "no-store");
const USER = process.env.PANEL_USER ?? "";
const PASS = process.env.PANEL_PASS ?? "";
const ADMIN_KEY = process.env.SOCIOS_ADMIN_KEY ?? "";
// La llamada servidor-a-servidor va a la URL DIRECTA del Worker (workers.dev):
// el escudo anti-bots del dominio público devolvía 403 a los fetch desde la
// función de Vercel (descubierto el 18-ago al encender, KAN-122). La URL no es
// secreta (la API exige clave en todos los métodos) y SOCIOS_API_URL permite
// cambiarla sin tocar código.
const API_BASE = (process.env.SOCIOS_API_URL ?? "https://calma-society.calmasocietyweb.workers.dev").replace(/\/$/, "");
const API = `${API_BASE}/api/socios`;

// Auth básica (solo cuando hay servidor en Vercel y credenciales definidas).
if (onVercel && USER && PASS) {
  const auth = Astro.request.headers.get("authorization") ?? "";
  const b64 = auth.startsWith("Basic ") ? auth.slice(6) : "";
  let ok = false;
  if (b64) {
    const [u, p] = atob(b64).split(":");
    ok = u === USER && p === PASS;
  }
  if (!ok) {
    return new Response("Autenticación requerida", {
      status: 401,
      headers: { "WWW-Authenticate": 'Basic realm="Panel Calma Society"', "cache-control": "no-store" },
    });
  }
}

const configured = onVercel && !!ADMIN_KEY && !!USER && !!PASS;

// ── Acciones (POST desde los formularios de esta misma página) ───────────────
if (onVercel && configured && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const g = (k: string) => {
    const v = form.get(k);
    return typeof v === "string" ? v.trim() : "";
  };
  const accion = g("accion");
  const socioParam = g("socio"); // para volver a la vista de detalle
  const volver = (extra: string) =>
    Astro.redirect(
      `${Astro.url.pathname}?${socioParam ? `socio=${encodeURIComponent(socioParam)}&` : ""}${extra}`,
      303,
    );

  let payload: Record<string, unknown> | null = null;
  if (accion === "snapshot") {
    payload = { accion: "snapshot", mes: g("mes") || undefined };
  } else if (accion === "socio-editar") {
    payload = {
      accion: "actualizar",
      tabla: "socios",
      id: g("id"),
      datos: {
        estado: g("estado"),
        proxima_accion: g("proxima_accion"),
        fecha_seguimiento: g("fecha_seguimiento"),
        dijo: g("dijo"),
        notas: g("notas"),
      },
    };
  } else if (accion === "trato-nuevo") {
    const precio = g("precio") === "" ? 0 : parseEuros(g("precio"));
    if (precio === null) return volver("error=precio");
    payload = {
      accion: "crear",
      tabla: "tratos",
      datos: {
        socio_id: g("socio_id"),
        modelo: g("modelo"),
        estado: "activo",
        trato: g("trato"),
        contraprestacion: g("contraprestacion"),
        precio_anual_cents: precio,
        inicio: g("inicio"),
        fin: g("fin"),
        renovable: form.get("renovable") ? 1 : 0,
        etiquetado: g("etiquetado"),
        notas: g("notas"),
      },
    };
  } else if (accion === "trato-estado") {
    payload = {
      accion: "actualizar",
      tabla: "tratos",
      id: Number(g("id")),
      datos: { estado: g("estado") },
    };
  } else if (accion === "cobro-nuevo") {
    const importe = parseEuros(g("importe"));
    if (importe === null) return volver("error=importe");
    payload = {
      accion: "crear",
      tabla: "cobros",
      datos: {
        socio_id: g("socio_id"),
        trato_id: g("trato_id") ? Number(g("trato_id")) : null,
        fecha: g("fecha"),
        concepto: g("concepto"),
        importe_cents: importe,
        facturado: form.get("facturado") ? 1 : 0,
        factura_ref: g("factura_ref"),
        cobrado: form.get("cobrado") ? 1 : 0,
        fecha_cobro: g("fecha_cobro"),
        notas: g("notas"),
      },
    };
  }

  if (!payload) return volver("error=accion");
  try {
    const r = await fetch(API, {
      method: "POST",
      headers: { "content-type": "application/json", "x-admin-key": ADMIN_KEY },
      body: JSON.stringify(payload),
    });
    if (r.status === 503) return volver("error=apagada");
    if (!r.ok) return volver(`error=api-${r.status}`);
    return volver("ok=1");
  } catch {
    return volver("error=red");
  }
}

// ── Datos (GET a la API) ─────────────────────────────────────────────────────
let apagada = false;
let error: string | null = null;
let socios: SocioRow[] = [];
let tratos: TratoRow[] = [];
let cobros: CobroRow[] = [];
let mediciones: MedicionRow[] = [];

if (configured) {
  try {
    const r = await fetch(API, { headers: { "x-admin-key": ADMIN_KEY } });
    if (r.status === 503) {
      apagada = true;
    } else if (!r.ok) {
      error = `API ${r.status}`;
    } else {
      const data = await r.json();
      socios = data.socios ?? [];
      tratos = data.tratos ?? [];
      cobros = data.cobros ?? [];
      mediciones = data.mediciones ?? [];
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const hoy = new Date();
const resumen = resumenDinero(socios, tratos, cobros, mediciones, hoy);
const curva = curvaMensual(cobros, mediciones, hoy, 12);
const av = avisos(socios, tratos, cobros, hoy);
const filasTodas = filasSocios(socios, tratos, cobros, mediciones, hoy);

// Filtro por estado de la relación.
const filtroEstado = Astro.url.searchParams.get("estado") ?? "";
const filas = filtroEstado ? filasTodas.filter((f) => f.estado === filtroEstado) : filasTodas;

// Vista de detalle de un socio (?socio=<id>).
const socioId = Astro.url.searchParams.get("socio") ?? "";
const socio = socios.find((s) => s.id === socioId) ?? null;
const tratosSocio = socio ? tratos.filter((t) => t.socio_id === socio.id) : [];
const cobrosSocio = socio ? cobros.filter((c) => c.socio_id === socio.id) : [];
const medicionesSocio = socio
  ? mediciones.filter((m) => m.socio_id === socio.id).slice(0, 12)
  : [];

// Estado de la última foto mensual y el mes que fotografiaría el botón.
const ultimaFoto = mediciones.reduce(
  (max, m) => ((m as any).calculado_en > max ? ((m as any).calculado_en as string) : max),
  "",
);
const mesFoto = mesAnterior(hoy);

// Barras del libro mensual: anchos relativos al máximo de cada serie (CSS puro).
const maxCobrado = Math.max(1, ...curva.map((c) => c.cobradoCents));
const maxClics = Math.max(1, ...curva.map((c) => c.clics));

const okMsg = Astro.url.searchParams.get("ok");
const errMsg = Astro.url.searchParams.get("error");
const nombreSocio = (id: string) => socios.find((s) => s.id === id)?.nombre ?? id;
const fmtFecha = (iso: string) => (iso ? iso.slice(0, 10) : "—");
const label = (v: string) => LABELS[v] ?? v;

// Color del badge según el estado (semántica contable: verde entra, rojo no).
const BADGE_SOCIO: Record<string, string> = {
  socio: "es-verde",
  "respondio-si": "es-verde",
  contactado: "es-ambar",
  "respondio-no": "es-rojo",
};
const BADGE_TRATO: Record<string, string> = {
  activo: "es-verde",
  propuesto: "es-ambar",
  rechazado: "es-rojo",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Socios y dinero — Gestión</title>
  </head>
  <body class="bo">
    <header class="bo-topbar">
      <a class="bo-brand" href="/panel/">Gestión<small>Calma Society</small></a>
      <nav class="bo-topnav" aria-label="Secciones del panel">
        <a href="/panel/socios" aria-current="page">Socios y dinero</a>
        <a href="/panel/analitica">Analítica</a>
        <a href="/panel/reservas">Reservas</a>
      </nav>
      {
        onVercel && configured && !apagada && (
          <div class="bo-topbar-side">
            <span>{ultimaFoto ? `Última foto: ${ultimaFoto.slice(0, 10)}` : "Sin fotos mensuales"}</span>
            <form method="POST">
              <input type="hidden" name="accion" value="snapshot" />
              <input type="hidden" name="mes" value={mesFoto} />
              <button type="submit" class="bo-btn-quiet">Foto de {mesLabel(mesFoto)}</button>
            </form>
          </div>
        )
      }
    </header>

    <main class="bo-wrap">
      <h1 class="bo-h1">Socios y dinero</h1>
      {
        !onVercel && (
          <div class="bo-card bo-card-pad">
            <p style="margin:0 0 6px;font-weight:600;">Este panel funciona en el despliegue de edición.</p>
            <p class="bo-note" style="margin:0;">
              La web pública es estática y no muestra datos aquí. Abre el panel desde el
              despliegue de edición (Vercel), protegido con usuario y contraseña.
            </p>
          </div>
        )
      }

      {
        onVercel && !configured && (
          <div class="bo-card bo-card-pad">
            <p style="margin:0 0 6px;font-weight:600;">Falta configurar el panel de socios.</p>
            <p class="bo-note" style="margin:0;">
              Define en Vercel la variable <code>SOCIOS_ADMIN_KEY</code> (además de
              <code>PANEL_USER</code> y <code>PANEL_PASS</code>) y vuelve a desplegar. La misma
              clave debe estar como secreto en Cloudflare.
            </p>
          </div>
        )
      }

      {
        onVercel && configured && apagada && (
          <div class="bo-card bo-card-pad">
            <p style="margin:0 0 6px;font-weight:600;">Falta encender la base de datos.</p>
            <p class="bo-note">El sistema está desplegado pero la base D1 no existe. Encendido (una vez):</p>
            <ol class="bo-note" style="margin:6px 0 8px;padding-left:18px;">
              <li><code>npx wrangler login</code> y <code>npx wrangler d1 create calma-db</code></li>
              <li>Pegar el <code>database_id</code> en <code>wrangler.jsonc</code> y hacer push</li>
              <li>Secretos en Cloudflare y la misma <code>SOCIOS_ADMIN_KEY</code> en Vercel</li>
              <li>Cargar <code>db/socios-schema.sql</code> y el seed con wrangler</li>
            </ol>
            <p class="bo-note" style="margin:0;">Guía completa: <code>docs/PANEL-SOCIOS-DINERO.md</code></p>
          </div>
        )
      }

      {
        onVercel && configured && !apagada && (
          <>
            {error && <p class="bo-alerta es-error">No se pudo leer la API de socios: {error}</p>}
            {okMsg && <p class="bo-alerta es-ok">Guardado.</p>}
            {errMsg && <p class="bo-alerta es-error">No se guardó ({errMsg}). Revisa el dato y prueba otra vez.</p>}

            <section aria-label="Resumen de dinero" class="bo-strip">
              <div class="bo-cell">
                <p class="bo-kpi-label">Cobrado en {resumen.anyo}</p>
                <p class={`bo-kpi ${resumen.cobradoAnyoCents > 0 ? "es-verde" : "es-cero"}`}>
                  {formatEuros(resumen.cobradoAnyoCents)}
                </p>
                <p class="bo-kpi-note">Dinero recibido. La verdad.</p>
              </div>
              <div class="bo-cell">
                <p class="bo-kpi-label">Facturado sin cobrar</p>
                <p class={`bo-kpi ${resumen.facturadoSinCobrarCents > 0 ? "es-ambar" : "es-cero"}`}>
                  {formatEuros(resumen.facturadoSinCobrarCents)}
                </p>
                <p class="bo-kpi-note">Emitido y pendiente de entrar</p>
              </div>
              <div class="bo-cell">
                <p class="bo-kpi-label">Cuotas comprometidas</p>
                <p class={`bo-kpi ${resumen.comprometidoAnualCents > 0 ? "" : "es-cero"}`}>
                  {formatEuros(resumen.comprometidoAnualCents)}
                </p>
                <p class="bo-kpi-note">Al año. Compromiso, no ingreso</p>
              </div>
              <div class="bo-cell">
                <p class="bo-kpi-label">Clics entregados · {mesLabel(resumen.mesPasado)}</p>
                <p class={`bo-kpi ${resumen.clicsMesPasado > 0 ? "" : "es-cero"}`}>{resumen.clicsMesPasado}</p>
                <p class="bo-kpi-note">{resumen.visitasMesPasado} visitas a fichas de socios</p>
              </div>
              <div class="bo-cell">
                <p class="bo-kpi-label">Cartera</p>
                <p class="bo-kpi">
                  {resumen.nSocios} <small>/ {resumen.nTratoActivo} con trato</small>
                </p>
                <p class="bo-kpi-note">Socios registrados</p>
              </div>
            </section>

            <div class="bo-2col">
              <section class="bo-card" aria-labelledby="libro">
                <div class="bo-h">
                  <h2 id="libro">Libro mensual</h2>
                  <p class="bo-note">Euros cobrados y clics entregados, por mes</p>
                </div>
                <div class="bo-scroll">
                  <table class="bo-table">
                    <thead>
                      <tr>
                        <th scope="col">Mes</th>
                        <th scope="col">Cobrado</th>
                        <th scope="col">Clics</th>
                      </tr>
                    </thead>
                    <tbody>
                      {curva.map((c) => (
                        <tr>
                          <td style="white-space:nowrap;width:5.5rem;">{mesLabel(c.mes)}</td>
                          <td style="width:55%;">
                            <div class="bo-barra">
                              {c.cobradoCents > 0 && <i style={`width:${Math.max(2, Math.round((c.cobradoCents / maxCobrado) * 100))}%`} />}
                              <span class={c.cobradoCents === 0 ? "bo-cero" : ""}>{formatEuros(c.cobradoCents)}</span>
                            </div>
                          </td>
                          <td>
                            <div class="bo-barra">
                              {c.clics > 0 && <i class="gris" style={`width:${Math.max(2, Math.round((c.clics / maxClics) * 100))}%`} />}
                              <span class={c.clics === 0 ? "bo-cero" : ""}>{c.clics}</span>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>

              <section class="bo-card" aria-labelledby="avisos">
                <div class="bo-h">
                  <h2 id="avisos">Avisos</h2>
                  <p class="bo-note">Renovaciones y facturas viejas</p>
                </div>
                {av.renovaciones.length === 0 && av.facturasSinCobrar.length === 0 ? (
                  <p class="bo-vacio">Nada pendiente.</p>
                ) : (
                  <ul class="bo-lista">
                    {av.renovaciones.map((r) => (
                      <li>
                        <span class="bo-badge es-ambar">Renovación</span>{" "}
                        <a href={`?socio=${r.socio_id}`}>{nombreSocio(r.socio_id)}</a>: el trato termina el{" "}
                        {fmtFecha(r.fin)}
                        {r.dias >= 0 ? ` (en ${r.dias} días)` : ` (venció hace ${-r.dias} días)`}
                      </li>
                    ))}
                    {av.facturasSinCobrar.map((f) => (
                      <li>
                        <span class="bo-badge es-rojo">Sin cobrar</span>{" "}
                        <a href={`?socio=${f.socio_id}`}>{nombreSocio(f.socio_id)}</a>: factura de{" "}
                        {formatEuros(f.importe_cents)} del {fmtFecha(f.fecha)} ({f.dias} días)
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            </div>

            {socio && (
              <section class="bo-card" aria-labelledby="detalle">
                <div class="bo-det-head">
                  <h2 id="detalle">{socio.nombre}</h2>
                  <a href={Astro.url.pathname} class="bo-cerrar">Cerrar</a>
                </div>
                <div class="bo-det-meta">
                  <p class="bo-note" style="margin:0 0 4px;">
                    <span class={`bo-badge ${BADGE_SOCIO[socio.estado] ?? ""}`}>{label(socio.estado)}</span>{" "}
                    {label(String(socio.tipo))}
                    {socio.zona ? ` · ${socio.zona}` : ""}
                    {socio.tanda ? ` · Tanda ${socio.tanda}` : ""}
                    {" · "}
                    {(socio as any).web ? (
                      <a href={String((socio as any).web)} target="_blank" rel="noopener">web ↗</a>
                    ) : (
                      "sin web"
                    )}
                    {(socio as any).url_ficha && (
                      <>
                        {" · "}
                        <a href={String((socio as any).url_ficha)} target="_blank" rel="noopener">su ficha ↗</a>
                      </>
                    )}
                  </p>
                  <p class="bo-note" style="margin:0 0 4px;">
                    {(socio as any).contacto || (socio as any).email || (socio as any).telefono
                      ? [`${(socio as any).contacto}`, `${(socio as any).email}`, `${(socio as any).telefono}`]
                          .filter(Boolean)
                          .join(" · ")
                      : "Sin datos de contacto registrados."}
                  </p>
                  <p class="bo-note-min" style="margin:0;">
                    Ficha en la web: datos {socio.datos_ok ? "sí" : "no"} · fotos {socio.fotos_ok ? "sí" : "no"} ·
                    enlace {socio.enlace_ok ? "sí" : "no"}
                  </p>
                </div>

                <div class="bo-h"><h3>Ficha de la relación</h3></div>
                <form method="POST" class="bo-form" style="padding:12px 16px 16px;">
                  <input type="hidden" name="accion" value="socio-editar" />
                  <input type="hidden" name="socio" value={socio.id} />
                  <input type="hidden" name="id" value={socio.id} />
                  <label class="bo-campo">
                    <span>Estado de la relación</span>
                    <select name="estado" class="bo-select">
                      {ESTADOS_SOCIO.map((e) => (
                        <option value={e} selected={socio.estado === e}>{label(e)}</option>
                      ))}
                    </select>
                  </label>
                  <label class="bo-campo">
                    <span>Fecha de seguimiento</span>
                    <input type="date" name="fecha_seguimiento" value={String((socio as any).fecha_seguimiento ?? "")} class="bo-input" />
                  </label>
                  <label class="bo-campo ancho">
                    <span>Qué dijo</span>
                    <input type="text" name="dijo" value={String((socio as any).dijo ?? "")} class="bo-input" />
                  </label>
                  <label class="bo-campo ancho">
                    <span>Próxima acción</span>
                    <input type="text" name="proxima_accion" value={String((socio as any).proxima_accion ?? "")} class="bo-input" />
                  </label>
                  <label class="bo-campo ancho">
                    <span>Notas</span>
                    <textarea name="notas" rows="2" class="bo-textarea">{String((socio as any).notas ?? "")}</textarea>
                  </label>
                  <div class="ancho">
                    <button type="submit" class="bo-btn">Guardar ficha</button>
                  </div>
                </form>

                <div class="bo-h">
                  <h3>Tratos</h3>
                  <p class="bo-note">Histórico completo; una fila por acuerdo</p>
                </div>
                {tratosSocio.length === 0 ? (
                  <p class="bo-vacio">Sin tratos registrados.</p>
                ) : (
                  <div class="bo-scroll">
                    <table class="bo-table">
                      <thead>
                        <tr>
                          <th scope="col">Modelo</th>
                          <th scope="col">Estado</th>
                          <th scope="col" class="num">Precio/año</th>
                          <th scope="col">Vigencia</th>
                          <th scope="col">Etiquetado</th>
                          <th scope="col">Detalle</th>
                          <th scope="col"></th>
                        </tr>
                      </thead>
                      <tbody>
                        {tratosSocio.map((t) => (
                          <tr>
                            <td style="font-weight:600;">{label(t.modelo)}</td>
                            <td><span class={`bo-badge ${BADGE_TRATO[t.estado] ?? ""}`}>{label(t.estado)}</span></td>
                            <td class={`num ${t.precio_anual_cents === 0 ? "bo-cero" : ""}`}>{formatEuros(t.precio_anual_cents)}</td>
                            <td class="bo-note" style="white-space:nowrap;">
                              {fmtFecha(t.inicio)} → {t.fin ? fmtFecha(t.fin) : "sin fin"}
                              {t.renovable ? " · renovable" : ""}
                            </td>
                            <td class="bo-note">{label(String((t as any).etiquetado ?? "editorial"))}</td>
                            <td class="bo-note">
                              {(t as any).trato || "—"}
                              {(t as any).contraprestacion ? ` · nos dan: ${(t as any).contraprestacion}` : ""}
                            </td>
                            <td style="white-space:nowrap;">
                              {t.estado === "activo" && (
                                <span style="display:inline-flex;gap:6px;">
                                  {["terminado", "rechazado"].map((e) => (
                                    <form method="POST" style="display:inline;">
                                      <input type="hidden" name="accion" value="trato-estado" />
                                      <input type="hidden" name="socio" value={socio.id} />
                                      <input type="hidden" name="id" value={String(t.id)} />
                                      <button type="submit" name="estado" value={e} class={`bo-btn-quiet ${e === "rechazado" ? "es-rojo" : ""}`}>
                                        {label(e)}
                                      </button>
                                    </form>
                                  ))}
                                </span>
                              )}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                <details class="bo-details" style="border-top:1px solid var(--bo-line);">
                  <summary>Nuevo trato</summary>
                  <form method="POST" class="bo-form">
                    <input type="hidden" name="accion" value="trato-nuevo" />
                    <input type="hidden" name="socio" value={socio.id} />
                    <input type="hidden" name="socio_id" value={socio.id} />
                    <label class="bo-campo">
                      <span>Modelo</span>
                      <select name="modelo" class="bo-select">
                        {MODELOS_TRATO.map((m) => (
                          <option value={m}>{label(m)}</option>
                        ))}
                      </select>
                    </label>
                    <label class="bo-campo">
                      <span>Precio anual en euros (0 = trueque)</span>
                      <input type="text" name="precio" placeholder="300" class="bo-input" />
                    </label>
                    <label class="bo-campo ancho">
                      <span>El trato (qué damos)</span>
                      <input type="text" name="trato" class="bo-input" />
                    </label>
                    <label class="bo-campo ancho">
                      <span>Contraprestación (qué nos dan)</span>
                      <input type="text" name="contraprestacion" class="bo-input" />
                    </label>
                    <label class="bo-campo">
                      <span>Inicio</span>
                      <input type="date" name="inicio" class="bo-input" />
                    </label>
                    <label class="bo-campo">
                      <span>Fin (vacío = sin fin)</span>
                      <input type="date" name="fin" class="bo-input" />
                    </label>
                    <label class="bo-check">
                      <input type="checkbox" name="renovable" value="1" />
                      Renovable
                    </label>
                    <label class="bo-campo">
                      <span>Etiquetado en la web</span>
                      <select name="etiquetado" class="bo-select">
                        {ETIQUETADOS.map((e) => (
                          <option value={e}>{label(e)}</option>
                        ))}
                      </select>
                    </label>
                    <p class="bo-note-min ancho" style="margin:0;">
                      Si el trato es pagado, la ficha pública se etiqueta y su enlace pasa a
                      rel="sponsored". Es ley y protege la confianza.
                    </p>
                    <label class="bo-campo ancho">
                      <span>Notas</span>
                      <input type="text" name="notas" class="bo-input" />
                    </label>
                    <div class="ancho">
                      <button type="submit" class="bo-btn">Guardar trato</button>
                    </div>
                  </form>
                </details>

                <div class="bo-h">
                  <h3>Cobros</h3>
                  <p class="bo-note">El único origen de verdad del dinero. La factura la emite la gestoría.</p>
                </div>
                {cobrosSocio.length === 0 ? (
                  <p class="bo-vacio">Sin cobros registrados.</p>
                ) : (
                  <div class="bo-scroll">
                    <table class="bo-table">
                      <thead>
                        <tr>
                          <th scope="col">Fecha</th>
                          <th scope="col">Concepto</th>
                          <th scope="col" class="num">Importe</th>
                          <th scope="col">Factura</th>
                          <th scope="col">Cobrado</th>
                        </tr>
                      </thead>
                      <tbody>
                        {cobrosSocio.map((c) => (
                          <tr>
                            <td style="white-space:nowrap;">{fmtFecha(c.fecha)}</td>
                            <td>{(c as any).concepto}</td>
                            <td class="num" style="font-weight:600;">{formatEuros(c.importe_cents)}</td>
                            <td class="bo-note">{c.facturado ? (c as any).factura_ref || "sí" : "no"}</td>
                            <td>
                              {c.cobrado ? (
                                <span class="bo-badge es-verde">sí · {fmtFecha(c.fecha_cobro)}</span>
                              ) : (
                                <span class="bo-badge es-ambar">pendiente</span>
                              )}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                <details class="bo-details" style="border-top:1px solid var(--bo-line);" open={cobrosSocio.length === 0}>
                  <summary>Registrar cobro</summary>
                  <form method="POST" class="bo-form">
                    <input type="hidden" name="accion" value="cobro-nuevo" />
                    <input type="hidden" name="socio" value={socio.id} />
                    <input type="hidden" name="socio_id" value={socio.id} />
                    <label class="bo-campo">
                      <span>Fecha (factura o acuerdo)</span>
                      <input type="date" name="fecha" required class="bo-input" />
                    </label>
                    <label class="bo-campo">
                      <span>Importe en euros</span>
                      <input type="text" name="importe" required placeholder="300" class="bo-input" />
                    </label>
                    <label class="bo-campo ancho">
                      <span>Concepto</span>
                      <input type="text" name="concepto" required placeholder="Cuota de directorio sep-2026 a sep-2027" class="bo-input" />
                    </label>
                    <label class="bo-campo">
                      <span>Trato asociado (opcional)</span>
                      <select name="trato_id" class="bo-select">
                        <option value="">Ninguno</option>
                        {tratosSocio.map((t) => (
                          <option value={String(t.id)}>{`${label(t.modelo)} · ${formatEuros(t.precio_anual_cents)}/año`}</option>
                        ))}
                      </select>
                    </label>
                    <label class="bo-campo">
                      <span>Nº de factura</span>
                      <input type="text" name="factura_ref" class="bo-input" />
                    </label>
                    <label class="bo-check">
                      <input type="checkbox" name="facturado" value="1" />
                      Facturado
                    </label>
                    <label class="bo-check">
                      <input type="checkbox" name="cobrado" value="1" />
                      Cobrado (el dinero entró)
                    </label>
                    <label class="bo-campo">
                      <span>Fecha de cobro</span>
                      <input type="date" name="fecha_cobro" class="bo-input" />
                    </label>
                    <label class="bo-campo ancho">
                      <span>Notas</span>
                      <input type="text" name="notas" class="bo-input" />
                    </label>
                    <div class="ancho">
                      <button type="submit" class="bo-btn">Guardar cobro</button>
                    </div>
                  </form>
                </details>

                <div class="bo-h">
                  <h3>Valor entregado</h3>
                  <p class="bo-note">Se calcula solo. El socio lo ve en su analítica como calmasociety / referral</p>
                </div>
                {medicionesSocio.length === 0 ? (
                  <p class="bo-vacio">
                    Aún sin fotos mensuales{socio.slug_ficha ? "" : " (este socio no tiene ficha en la web)"}.
                  </p>
                ) : (
                  <div class="bo-scroll">
                    <table class="bo-table">
                      <thead>
                        <tr>
                          <th scope="col">Mes</th>
                          <th scope="col" class="num">Visitas a su ficha</th>
                          <th scope="col" class="num">Clics a su web</th>
                        </tr>
                      </thead>
                      <tbody>
                        {medicionesSocio.map((m) => (
                          <tr>
                            <td>{mesLabel(m.mes)}</td>
                            <td class={`num ${m.visitas_ficha === 0 ? "bo-cero" : ""}`}>{m.visitas_ficha}</td>
                            <td class={`num ${m.clics_web === 0 ? "bo-cero" : ""}`}>{m.clics_web}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </section>
            )}

            <section class="bo-card" aria-labelledby="cartera">
              <div class="bo-h">
                <h2 id="cartera">Cartera de socios</h2>
                <nav class="bo-filtro" aria-label="Filtro por estado">
                  {["", ...ESTADOS_SOCIO].map((e) => (
                    <a href={e ? `?estado=${e}` : Astro.url.pathname} aria-current={filtroEstado === e ? "true" : undefined}>
                      {e ? label(e) : `Todos (${filasTodas.length})`}
                    </a>
                  ))}
                </nav>
              </div>
              <div class="bo-scroll">
                <table class="bo-table">
                  <thead>
                    <tr>
                      <th scope="col">Socio</th>
                      <th scope="col">Tipo</th>
                      <th scope="col">Relación</th>
                      <th scope="col">Modelo vigente</th>
                      <th scope="col" class="num">Precio/año</th>
                      <th scope="col" class="num">Cobrado {resumen.anyo}</th>
                      <th scope="col" class="num">Clics · {mesLabel(resumen.mesPasado)}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filas.map((f) => (
                      <tr>
                        <td class="bo-fila-nombre"><a href={`?socio=${f.id}`}>{f.nombre}</a></td>
                        <td class="bo-note">{label(f.tipo)}</td>
                        <td><span class={`bo-badge ${BADGE_SOCIO[f.estado] ?? ""}`}>{label(f.estado)}</span></td>
                        <td class="bo-note">{f.modelo ? label(f.modelo) : "—"}</td>
                        <td class={`num ${f.precioAnualCents === 0 ? "bo-cero" : ""}`}>
                          {f.precioAnualCents > 0 ? formatEuros(f.precioAnualCents) : "—"}
                        </td>
                        <td class={`num ${f.cobradoAnyoCents === 0 ? "bo-cero" : ""}`} style={f.cobradoAnyoCents > 0 ? "font-weight:600;color:var(--bo-verde-2);" : ""}>
                          {formatEuros(f.cobradoAnyoCents)}
                        </td>
                        <td class={`num ${f.clicsMesPasado === 0 ? "bo-cero" : ""}`}>{f.clicsMesPasado}</td>
                      </tr>
                    ))}
                    {filas.length === 0 && (
                      <tr>
                        <td colspan="7" class="bo-vacio">
                          Sin socios{filtroEstado ? ` en estado «${label(filtroEstado)}»` : ""}. Carga el seed
                          (docs/PANEL-SOCIOS-DINERO.md §4).
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>

            <p class="bo-note-min" style="margin:0;">
              Regla del registro: «Cobrado» sale solo de los cobros que registras tú; las cuotas
              comprometidas y el valor entregado nunca lo engordan.
            </p>
          </>
        )
      }
    </main>
  </body>
</html>
