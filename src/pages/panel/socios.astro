---
/**
 * Panel de socios y dinero (KAN-122) — el registro interno del dinero.
 *
 * - SSR SOLO en Vercel (como analítica/reservas): en Cloudflare/local se
 *   prerenderiza un aviso estático sin secretos.
 * - Basic auth con PANEL_USER / PANEL_PASS (las mismas del resto del panel).
 * - Lee y escribe contra la API de Cloudflare (/api/socios) con la clave
 *   SOCIOS_ADMIN_KEY (variable en Vercel). Formularios POST-redirect-GET.
 * - Responde a tres preguntas, en este orden: ¿cuánto ha entrado? ·
 *   ¿quién nos debe qué? · ¿qué valor entregamos este mes?
 *
 * Regla de oro (no mezclar): los COBROS son dinero recibido y los escribe el
 * dueño; la MEDICIÓN mensual es valor entregado y se calcula sola desde Umami.
 */
// El prerender de esta pagina lo decide astro.config.ts (panel-ssr-en-vercel):
// SSR real solo en Vercel; estatica en Cloudflare/local. Un export const prerender
// con expresion NO funciona (Astro solo analiza literales) - leccion KAN-122.
import "../../styles/global.css";
import { SITE } from "../../config/site";
import {
  LABELS,
  ESTADOS_SOCIO,
  MODELOS_TRATO,
  ETIQUETADOS,
} from "../../lib/socios/catalog";
import { formatEuros, parseEuros, mesLabel, mesAnterior } from "../../lib/socios/money";
import {
  resumenDinero,
  curvaMensual,
  avisos,
  filasSocios,
  type SocioRow,
  type TratoRow,
  type CobroRow,
  type MedicionRow,
} from "../../lib/socios/resumen";

const onVercel = !!process.env.VERCEL;

// Página con autenticación y datos: PROHIBIDO que el edge la cachee (el
// adaptador emite public,max-age=0 por defecto y Vercel llegó a servir un HIT).
if (onVercel) Astro.response.headers.set("cache-control", "no-store");
const USER = process.env.PANEL_USER ?? "";
const PASS = process.env.PANEL_PASS ?? "";
const ADMIN_KEY = process.env.SOCIOS_ADMIN_KEY ?? "";
// La llamada servidor-a-servidor va a la URL DIRECTA del Worker (workers.dev):
// el escudo anti-bots del dominio público devolvía 403 a los fetch desde la
// función de Vercel (descubierto el 18-ago al encender, KAN-122). La URL no es
// secreta (la API exige clave en todos los métodos) y SOCIOS_API_URL permite
// cambiarla sin tocar código.
const API_BASE = (process.env.SOCIOS_API_URL ?? "https://calma-society.calmasocietyweb.workers.dev").replace(/\/$/, "");
const API = `${API_BASE}/api/socios`;

// Auth básica (solo cuando hay servidor en Vercel y credenciales definidas).
if (onVercel && USER && PASS) {
  const auth = Astro.request.headers.get("authorization") ?? "";
  const b64 = auth.startsWith("Basic ") ? auth.slice(6) : "";
  let ok = false;
  if (b64) {
    const [u, p] = atob(b64).split(":");
    ok = u === USER && p === PASS;
  }
  if (!ok) {
    return new Response("Autenticación requerida", {
      status: 401,
      headers: { "WWW-Authenticate": 'Basic realm="Panel Calma Society"', "cache-control": "no-store" },
    });
  }
}

const configured = onVercel && !!ADMIN_KEY && !!USER && !!PASS;

// ── Acciones (POST desde los formularios de esta misma página) ───────────────
if (onVercel && configured && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const g = (k: string) => {
    const v = form.get(k);
    return typeof v === "string" ? v.trim() : "";
  };
  const accion = g("accion");
  const socioParam = g("socio"); // para volver a la vista de detalle
  const volver = (extra: string) =>
    Astro.redirect(
      `${Astro.url.pathname}?${socioParam ? `socio=${encodeURIComponent(socioParam)}&` : ""}${extra}`,
      303,
    );

  let payload: Record<string, unknown> | null = null;
  if (accion === "snapshot") {
    payload = { accion: "snapshot", mes: g("mes") || undefined };
  } else if (accion === "socio-editar") {
    payload = {
      accion: "actualizar",
      tabla: "socios",
      id: g("id"),
      datos: {
        estado: g("estado"),
        proxima_accion: g("proxima_accion"),
        fecha_seguimiento: g("fecha_seguimiento"),
        dijo: g("dijo"),
        notas: g("notas"),
      },
    };
  } else if (accion === "trato-nuevo") {
    const precio = g("precio") === "" ? 0 : parseEuros(g("precio"));
    if (precio === null) return volver("error=precio");
    payload = {
      accion: "crear",
      tabla: "tratos",
      datos: {
        socio_id: g("socio_id"),
        modelo: g("modelo"),
        estado: "activo",
        trato: g("trato"),
        contraprestacion: g("contraprestacion"),
        precio_anual_cents: precio,
        inicio: g("inicio"),
        fin: g("fin"),
        renovable: form.get("renovable") ? 1 : 0,
        etiquetado: g("etiquetado"),
        notas: g("notas"),
      },
    };
  } else if (accion === "trato-estado") {
    payload = {
      accion: "actualizar",
      tabla: "tratos",
      id: Number(g("id")),
      datos: { estado: g("estado") },
    };
  } else if (accion === "cobro-nuevo") {
    const importe = parseEuros(g("importe"));
    if (importe === null) return volver("error=importe");
    payload = {
      accion: "crear",
      tabla: "cobros",
      datos: {
        socio_id: g("socio_id"),
        trato_id: g("trato_id") ? Number(g("trato_id")) : null,
        fecha: g("fecha"),
        concepto: g("concepto"),
        importe_cents: importe,
        facturado: form.get("facturado") ? 1 : 0,
        factura_ref: g("factura_ref"),
        cobrado: form.get("cobrado") ? 1 : 0,
        fecha_cobro: g("fecha_cobro"),
        notas: g("notas"),
      },
    };
  }

  if (!payload) return volver("error=accion");
  try {
    const r = await fetch(API, {
      method: "POST",
      headers: { "content-type": "application/json", "x-admin-key": ADMIN_KEY },
      body: JSON.stringify(payload),
    });
    if (r.status === 503) return volver("error=apagada");
    if (!r.ok) return volver(`error=api-${r.status}`);
    return volver("ok=1");
  } catch {
    return volver("error=red");
  }
}

// ── Datos (GET a la API) ─────────────────────────────────────────────────────
let apagada = false;
let error: string | null = null;
let socios: SocioRow[] = [];
let tratos: TratoRow[] = [];
let cobros: CobroRow[] = [];
let mediciones: MedicionRow[] = [];

if (configured) {
  try {
    const r = await fetch(API, { headers: { "x-admin-key": ADMIN_KEY } });
    if (r.status === 503) {
      apagada = true;
    } else if (!r.ok) {
      error = `API ${r.status}`;
    } else {
      const data = await r.json();
      socios = data.socios ?? [];
      tratos = data.tratos ?? [];
      cobros = data.cobros ?? [];
      mediciones = data.mediciones ?? [];
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const hoy = new Date();
const resumen = resumenDinero(socios, tratos, cobros, mediciones, hoy);
const curva = curvaMensual(cobros, mediciones, hoy, 12);
const av = avisos(socios, tratos, cobros, hoy);
const filasTodas = filasSocios(socios, tratos, cobros, mediciones, hoy);

// Filtro por estado de la relación (chips, como el panel de reservas).
const filtroEstado = Astro.url.searchParams.get("estado") ?? "";
const filas = filtroEstado ? filasTodas.filter((f) => f.estado === filtroEstado) : filasTodas;

// Vista de detalle de un socio (?socio=<id>).
const socioId = Astro.url.searchParams.get("socio") ?? "";
const socio = socios.find((s) => s.id === socioId) ?? null;
const tratosSocio = socio ? tratos.filter((t) => t.socio_id === socio.id) : [];
const cobrosSocio = socio ? cobros.filter((c) => c.socio_id === socio.id) : [];
const medicionesSocio = socio
  ? mediciones.filter((m) => m.socio_id === socio.id).slice(0, 12)
  : [];

// Estado de la última foto mensual y el mes que fotografiaría el botón.
const ultimaFoto = mediciones.reduce(
  (max, m) => ((m as any).calculado_en > max ? ((m as any).calculado_en as string) : max),
  "",
);
const mesFoto = mesAnterior(hoy);

// Barras de la curva: anchos relativos al máximo de cada serie (CSS puro).
const maxCobrado = Math.max(1, ...curva.map((c) => c.cobradoCents));
const maxClics = Math.max(1, ...curva.map((c) => c.clics));

const okMsg = Astro.url.searchParams.get("ok");
const errMsg = Astro.url.searchParams.get("error");
const nombreSocio = (id: string) => socios.find((s) => s.id === id)?.nombre ?? id;
const fmtFecha = (iso: string) => (iso ? iso.slice(0, 10) : "—");
const label = (v: string) => LABELS[v] ?? v;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel · Socios y dinero — Calma Society</title>
  </head>
  <body class="bg-lino font-sans text-piedra antialiased">
    <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-oro">
        <a href="/panel/" class="hover:text-arcilla">Calma Society · Panel</a> · Socios y dinero
      </p>
      <h1 class="mt-2 font-display text-3xl text-tinta">Socios y dinero</h1>

      {
        !onVercel && (
          <div class="mt-8 rounded-xl border border-niebla bg-arena/60 p-6">
            <p class="font-medium text-tinta">Este panel funciona en el despliegue de edición.</p>
            <p class="mt-2 text-sm text-piedra-suave">
              La web pública es estática y no muestra datos aquí. Abre el panel desde el
              despliegue de edición (Vercel), protegido con usuario y contraseña.
            </p>
          </div>
        )
      }

      {
        onVercel && !configured && (
          <div class="mt-8 rounded-xl border border-niebla bg-arena/60 p-6">
            <p class="font-medium text-tinta">Falta configurar el panel de socios.</p>
            <p class="mt-2 text-sm text-piedra-suave">
              Define en Vercel la variable <code>SOCIOS_ADMIN_KEY</code> (además de
              <code>PANEL_USER</code> y <code>PANEL_PASS</code>, que ya existen) y vuelve a
              desplegar. La misma clave debe estar como secreto en Cloudflare.
            </p>
          </div>
        )
      }

      {
        onVercel && configured && apagada && (
          <div class="mt-8 rounded-xl border border-terracota/40 bg-arena/60 p-6">
            <p class="font-display text-xl text-tinta">Falta encender la base de datos.</p>
            <p class="mt-2 max-w-prose text-sm text-piedra">
              El sistema está construido y desplegado, pero la base D1 aún no existe. El
              encendido son ~10 minutos, una sola vez:
            </p>
            <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-piedra">
              <li><code>npx wrangler login</code> y <code>npx wrangler d1 create calma-db</code></li>
              <li>Pegar el <code>database_id</code> en el bloque comentado de <code>wrangler.jsonc</code> y hacer push</li>
              <li>Secretos en Cloudflare: <code>SOCIOS_ADMIN_KEY</code>, <code>UMAMI_API_KEY</code>, <code>UMAMI_WEBSITE_ID</code></li>
              <li>La misma <code>SOCIOS_ADMIN_KEY</code> como variable en Vercel</li>
              <li>Cargar esquema y socios: <code>wrangler d1 execute calma-db --remote --file=db/socios-schema.sql</code> y <code>--file=COLABORACIONES/panel-seed/seed.sql</code></li>
              <li>Volver aquí y pulsar «Hacer la foto del mes»</li>
            </ol>
            <p class="mt-3 text-sm text-piedra-suave">
              Guía completa: <code>docs/PANEL-SOCIOS-DINERO.md</code> en el repositorio.
            </p>
          </div>
        )
      }

      {
        onVercel && configured && !apagada && (
          <div class="mt-8 space-y-10">
            {error && (
              <p class="rounded-md bg-terracota/10 p-4 text-sm text-terracota">
                No se pudo leer la API de socios: {error}
              </p>
            )}
            {okMsg && (
              <p class="rounded-md border border-niebla bg-arena/60 p-3 text-sm text-piedra">
                Guardado.
              </p>
            )}
            {errMsg && (
              <p class="rounded-md bg-terracota/10 p-3 text-sm text-terracota">
                No se guardó ({errMsg}). Revisa el dato y prueba otra vez.
              </p>
            )}

            <section aria-labelledby="dinero">
              <h2 id="dinero" class="font-display text-xl text-tinta">Dinero</h2>
              <p class="mt-1 text-sm text-piedra-suave">
                Lo cobrado sale solo de los cobros registrados; el compromiso y el valor
                entregado nunca lo engordan.
              </p>
              <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-5">
                <div class="rounded-xl border border-niebla p-4">
                  <p class="text-2xl font-semibold text-tinta">{formatEuros(resumen.cobradoAnyoCents)}</p>
                  <p class="text-xs uppercase tracking-wide text-piedra-suave">Cobrado en {resumen.anyo}</p>
                </div>
                <div class="rounded-xl border border-niebla p-4">
                  <p class="text-2xl font-semibold text-tinta">{formatEuros(resumen.facturadoSinCobrarCents)}</p>
                  <p class="text-xs uppercase tracking-wide text-piedra-suave">Facturado sin cobrar</p>
                </div>
                <div class="rounded-xl border border-niebla p-4">
                  <p class="text-2xl font-semibold text-tinta">{formatEuros(resumen.comprometidoAnualCents)}</p>
                  <p class="text-xs uppercase tracking-wide text-piedra-suave">
                    Cuotas anuales comprometidas
                  </p>
                  <p class="mt-1 text-[11px] text-piedra-suave">Compromiso, no ingreso</p>
                </div>
                <div class="rounded-xl border border-niebla p-4">
                  <p class="text-2xl font-semibold text-tinta">{resumen.clicsMesPasado}</p>
                  <p class="text-xs uppercase tracking-wide text-piedra-suave">
                    Clics entregados · {mesLabel(resumen.mesPasado)}
                  </p>
                  <p class="mt-1 text-[11px] text-piedra-suave">{resumen.visitasMesPasado} visitas a fichas</p>
                </div>
                <div class="rounded-xl border border-niebla p-4">
                  <p class="text-2xl font-semibold text-tinta">
                    {resumen.nSocios} <span class="text-base font-normal text-piedra-suave">/ {resumen.nTratoActivo}</span>
                  </p>
                  <p class="text-xs uppercase tracking-wide text-piedra-suave">Socios / con trato activo</p>
                </div>
              </div>
            </section>

            <section aria-labelledby="curva">
              <h2 id="curva" class="font-display text-xl text-tinta">Curva mensual</h2>
              <p class="mt-1 text-sm text-piedra-suave">
                Por mes: euros cobrados (terracota) y clics entregados a socios (dorado). La
                curva que el Excel nunca tuvo.
              </p>
              <div class="mt-4 overflow-x-auto rounded-xl border border-niebla p-4">
                <table class="w-full min-w-[36rem] text-sm">
                  <thead>
                    <tr class="text-left text-xs uppercase tracking-wide text-piedra-suave">
                      <th scope="col" class="w-24 py-1 pr-3 font-medium">Mes</th>
                      <th scope="col" class="py-1 pr-3 font-medium">Cobrado</th>
                      <th scope="col" class="py-1 font-medium">Clics</th>
                    </tr>
                  </thead>
                  <tbody>
                    {curva.map((c) => (
                      <tr class="align-middle">
                        <td class="py-1.5 pr-3 whitespace-nowrap text-piedra">{mesLabel(c.mes)}</td>
                        <td class="w-1/2 py-1.5 pr-3">
                          <div class="flex items-center gap-2">
                            <div class="h-3 rounded-sm bg-terracota" style={`width:${Math.round((c.cobradoCents / maxCobrado) * 100)}%`} />
                            <span class={c.cobradoCents > 0 ? "shrink-0 text-xs font-semibold text-tinta" : "shrink-0 text-xs text-niebla"}>
                              {formatEuros(c.cobradoCents)}
                            </span>
                          </div>
                        </td>
                        <td class="w-1/3 py-1.5">
                          <div class="flex items-center gap-2">
                            <div class="h-3 rounded-sm bg-oro-vivo" style={`width:${Math.round((c.clics / maxClics) * 100)}%`} />
                            <span class={c.clics > 0 ? "shrink-0 text-xs font-semibold text-tinta" : "shrink-0 text-xs text-niebla"}>
                              {c.clics}
                            </span>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>

            <section aria-labelledby="avisos">
              <h2 id="avisos" class="font-display text-xl text-tinta">Renovaciones y avisos</h2>
              {av.renovaciones.length === 0 && av.facturasSinCobrar.length === 0 ? (
                <p class="mt-2 text-sm text-piedra-suave">Nada pendiente.</p>
              ) : (
                <ul class="mt-3 space-y-2 text-sm">
                  {av.renovaciones.map((r) => (
                    <li class="rounded-md border border-niebla p-3">
                      <a href={`?socio=${r.socio_id}`} class="font-medium text-arcilla underline decoration-niebla underline-offset-2">
                        {nombreSocio(r.socio_id)}
                      </a>{": "}
                      el trato termina el {fmtFecha(r.fin)}
                      {r.dias >= 0 ? ` (en ${r.dias} días)` : ` (venció hace ${-r.dias} días)`}
                    </li>
                  ))}
                  {av.facturasSinCobrar.map((f) => (
                    <li class="rounded-md border border-terracota/40 p-3">
                      <a href={`?socio=${f.socio_id}`} class="font-medium text-arcilla underline decoration-niebla underline-offset-2">
                        {nombreSocio(f.socio_id)}
                      </a>{": "}
                      factura de {formatEuros(f.importe_cents)} del {fmtFecha(f.fecha)} sin cobrar ({f.dias} días)
                    </li>
                  ))}
                </ul>
              )}
            </section>

            {socio && (
              <section aria-labelledby="detalle" class="rounded-xl border border-niebla bg-arena/40 p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 id="detalle" class="font-display text-2xl text-tinta">{socio.nombre}</h2>
                  <a href={Astro.url.pathname} class="text-sm text-piedra-suave hover:text-arcilla">
                    Cerrar detalle ×
                  </a>
                </div>
                <p class="mt-1 text-sm text-piedra-suave">
                  {label(String(socio.tipo))}
                  {socio.zona ? ` · ${socio.zona}` : ""}
                  {socio.tanda ? ` · Tanda ${socio.tanda}` : ""} ·{" "}
                  {(socio as any).web ? (
                    <a href={String((socio as any).web)} target="_blank" rel="noopener" class="underline decoration-niebla underline-offset-2">
                      web ↗
                    </a>
                  ) : (
                    "sin web"
                  )}
                  {(socio as any).url_ficha ? (
                    <>
                      {" · "}
                      <a href={String((socio as any).url_ficha)} target="_blank" rel="noopener" class="underline decoration-niebla underline-offset-2">
                        su ficha ↗
                      </a>
                    </>
                  ) : null}
                </p>
                <p class="mt-2 text-sm text-piedra">
                  {(socio as any).contacto || (socio as any).email || (socio as any).telefono
                    ? [`${(socio as any).contacto}`, `${(socio as any).email}`, `${(socio as any).telefono}`].filter(Boolean).join(" · ")
                    : "Sin datos de contacto registrados."}
                </p>
                <p class="mt-1 text-xs text-piedra-suave">
                  Ficha: datos {socio.datos_ok ? "sí" : "no"} · fotos {socio.fotos_ok ? "sí" : "no"} · enlace {socio.enlace_ok ? "sí" : "no"}
                </p>

                <form method="POST" class="mt-5 grid gap-3 rounded-lg border border-niebla bg-lino p-4 sm:grid-cols-2">
                  <input type="hidden" name="accion" value="socio-editar" />
                  <input type="hidden" name="socio" value={socio.id} />
                  <input type="hidden" name="id" value={socio.id} />
                  <label class="text-sm">
                    <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Estado de la relación</span>
                    <select name="estado" class="w-full rounded-md border border-niebla bg-lino px-3 py-2">
                      {ESTADOS_SOCIO.map((e) => (
                        <option value={e} selected={socio.estado === e}>{label(e)}</option>
                      ))}
                    </select>
                  </label>
                  <label class="text-sm">
                    <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Fecha de seguimiento</span>
                    <input type="date" name="fecha_seguimiento" value={String((socio as any).fecha_seguimiento ?? "")} class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                  </label>
                  <label class="text-sm sm:col-span-2">
                    <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">¿Qué dijo?</span>
                    <input type="text" name="dijo" value={String((socio as any).dijo ?? "")} class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                  </label>
                  <label class="text-sm sm:col-span-2">
                    <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Próxima acción</span>
                    <input type="text" name="proxima_accion" value={String((socio as any).proxima_accion ?? "")} class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                  </label>
                  <label class="text-sm sm:col-span-2">
                    <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Notas</span>
                    <textarea name="notas" rows="2" class="w-full rounded-md border border-niebla bg-lino px-3 py-2">{String((socio as any).notas ?? "")}</textarea>
                  </label>
                  <div class="sm:col-span-2">
                    <button type="submit" class="rounded-md bg-arcilla px-4 py-2 text-sm font-semibold text-crema hover:bg-terracota">
                      Guardar ficha
                    </button>
                  </div>
                </form>

                <h3 class="mt-6 font-display text-lg text-tinta">Tratos (histórico)</h3>
                {tratosSocio.length === 0 ? (
                  <p class="mt-1 text-sm text-piedra-suave">Sin tratos registrados.</p>
                ) : (
                  <ul class="mt-2 space-y-2">
                    {tratosSocio.map((t) => (
                      <li class="rounded-md border border-niebla bg-lino p-3 text-sm">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <p>
                            <span class="font-semibold text-tinta">{label(t.modelo)}</span>
                            {" · "}
                            <span class={t.estado === "activo" ? "text-arcilla" : "text-piedra-suave"}>{label(t.estado)}</span>
                            {" · "}
                            <span class="font-semibold text-tinta">{formatEuros(t.precio_anual_cents)}</span>/año
                            {" · "}
                            {label(String((t as any).etiquetado ?? "editorial"))}
                          </p>
                          {t.estado === "activo" && (
                            <span class="flex gap-1.5">
                              {["terminado", "rechazado"].map((e) => (
                                <form method="POST">
                                  <input type="hidden" name="accion" value="trato-estado" />
                                  <input type="hidden" name="socio" value={socio.id} />
                                  <input type="hidden" name="id" value={String(t.id)} />
                                  <button type="submit" name="estado" value={e} class="rounded-md border border-niebla px-2.5 py-1 text-xs font-semibold text-piedra hover:border-terracota">
                                    {label(e)}
                                  </button>
                                </form>
                              ))}
                            </span>
                          )}
                        </div>
                        <p class="mt-1 text-xs text-piedra-suave">
                          {fmtFecha(t.inicio)} → {t.fin ? fmtFecha(t.fin) : "sin fin"}
                          {t.renovable ? " · renovable" : ""}
                          {(t as any).trato ? ` · ${(t as any).trato}` : ""}
                          {(t as any).contraprestacion ? ` · nos dan: ${(t as any).contraprestacion}` : ""}
                        </p>
                      </li>
                    ))}
                  </ul>
                )}

                <details class="mt-3">
                  <summary class="cursor-pointer text-sm font-semibold text-arcilla">Nuevo trato</summary>
                  <form method="POST" class="mt-3 grid gap-3 rounded-lg border border-niebla bg-lino p-4 sm:grid-cols-2">
                    <input type="hidden" name="accion" value="trato-nuevo" />
                    <input type="hidden" name="socio" value={socio.id} />
                    <input type="hidden" name="socio_id" value={socio.id} />
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Modelo</span>
                      <select name="modelo" class="w-full rounded-md border border-niebla bg-lino px-3 py-2">
                        {MODELOS_TRATO.map((m) => (
                          <option value={m}>{label(m)}</option>
                        ))}
                      </select>
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Precio anual (€; 0 = trueque)</span>
                      <input type="text" name="precio" placeholder="p. ej. 300" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">El trato (qué damos)</span>
                      <input type="text" name="trato" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Contraprestación (qué nos dan)</span>
                      <input type="text" name="contraprestacion" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Inicio</span>
                      <input type="date" name="inicio" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Fin (vacío = sin fin)</span>
                      <input type="date" name="fin" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="renovable" value="1" class="rounded border-niebla" />
                      Renovable
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Etiquetado en la web</span>
                      <select name="etiquetado" class="w-full rounded-md border border-niebla bg-lino px-3 py-2">
                        {ETIQUETADOS.map((e) => (
                          <option value={e}>{label(e)}</option>
                        ))}
                      </select>
                    </label>
                    <p class="text-xs text-piedra-suave sm:col-span-2">
                      Si el trato es pagado, la ficha pública se etiqueta y su enlace pasa a
                      rel="sponsored" (cambio editorial aparte; es ley y es el moat).
                    </p>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Notas</span>
                      <input type="text" name="notas" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <div class="sm:col-span-2">
                      <button type="submit" class="rounded-md bg-arcilla px-4 py-2 text-sm font-semibold text-crema hover:bg-terracota">
                        Guardar trato
                      </button>
                    </div>
                  </form>
                </details>

                <h3 class="mt-6 font-display text-lg text-tinta">Cobros</h3>
                <p class="mt-1 text-xs text-piedra-suave">
                  Este formulario es el único origen de verdad del dinero. La factura la emite la
                  gestoría; aquí se registra su referencia y si el importe entró.
                </p>
                {cobrosSocio.length === 0 ? (
                  <p class="mt-2 text-sm text-piedra-suave">Sin cobros registrados.</p>
                ) : (
                  <div class="mt-2 overflow-x-auto rounded-md border border-niebla bg-lino">
                    <table class="w-full min-w-[34rem] text-sm">
                      <thead class="bg-arena/60 text-xs uppercase tracking-wide text-piedra-suave">
                        <tr>
                          <th scope="col" class="px-3 py-2 text-left">Fecha</th>
                          <th scope="col" class="px-3 py-2 text-left">Concepto</th>
                          <th scope="col" class="px-3 py-2 text-right">Importe</th>
                          <th scope="col" class="px-3 py-2 text-left">Factura</th>
                          <th scope="col" class="px-3 py-2 text-left">Cobrado</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-niebla">
                        {cobrosSocio.map((c) => (
                          <tr>
                            <td class="px-3 py-2 whitespace-nowrap">{fmtFecha(c.fecha)}</td>
                            <td class="px-3 py-2">{(c as any).concepto}</td>
                            <td class="px-3 py-2 text-right font-semibold text-tinta">{formatEuros(c.importe_cents)}</td>
                            <td class="px-3 py-2">{c.facturado ? ((c as any).factura_ref || "sí") : "no"}</td>
                            <td class="px-3 py-2">{c.cobrado ? `sí · ${fmtFecha(c.fecha_cobro)}` : "no"}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                <details class="mt-3" open={cobrosSocio.length === 0}>
                  <summary class="cursor-pointer text-sm font-semibold text-arcilla">Registrar cobro</summary>
                  <form method="POST" class="mt-3 grid gap-3 rounded-lg border border-niebla bg-lino p-4 sm:grid-cols-2">
                    <input type="hidden" name="accion" value="cobro-nuevo" />
                    <input type="hidden" name="socio" value={socio.id} />
                    <input type="hidden" name="socio_id" value={socio.id} />
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Fecha (de la factura o el acuerdo)</span>
                      <input type="date" name="fecha" required class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Importe (€)</span>
                      <input type="text" name="importe" required placeholder="p. ej. 300" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Concepto</span>
                      <input type="text" name="concepto" required placeholder="p. ej. Cuota de directorio sep-2026 a sep-2027" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Trato asociado (opcional)</span>
                      <select name="trato_id" class="w-full rounded-md border border-niebla bg-lino px-3 py-2">
                        <option value="">Ninguno</option>
                        {tratosSocio.map((t) => (
                          <option value={String(t.id)}>{`${label(t.modelo)} · ${formatEuros(t.precio_anual_cents)}/año`}</option>
                        ))}
                      </select>
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Nº de factura</span>
                      <input type="text" name="factura_ref" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="facturado" value="1" class="rounded border-niebla" />
                      Facturado
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="cobrado" value="1" class="rounded border-niebla" />
                      Cobrado (el dinero ENTRÓ)
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Fecha de cobro</span>
                      <input type="date" name="fecha_cobro" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block text-xs uppercase tracking-wide text-piedra-suave">Notas</span>
                      <input type="text" name="notas" class="w-full rounded-md border border-niebla bg-lino px-3 py-2" />
                    </label>
                    <div class="sm:col-span-2">
                      <button type="submit" class="rounded-md bg-arcilla px-4 py-2 text-sm font-semibold text-crema hover:bg-terracota">
                        Guardar cobro
                      </button>
                    </div>
                  </form>
                </details>

                <h3 class="mt-6 font-display text-lg text-tinta">Valor entregado (medición mensual)</h3>
                <p class="mt-1 text-xs text-piedra-suave">
                  Se calcula solo desde Umami. El socio puede comprobarlo en su propia analítica:
                  llegamos como calmasociety / referral.
                </p>
                {medicionesSocio.length === 0 ? (
                  <p class="mt-2 text-sm text-piedra-suave">
                    Aún sin fotos mensuales{socio.slug_ficha ? "" : " (este socio no tiene ficha en la web)"}.
                  </p>
                ) : (
                  <div class="mt-2 overflow-x-auto rounded-md border border-niebla bg-lino">
                    <table class="w-full min-w-[22rem] text-sm">
                      <thead class="bg-arena/60 text-xs uppercase tracking-wide text-piedra-suave">
                        <tr>
                          <th scope="col" class="px-3 py-2 text-left">Mes</th>
                          <th scope="col" class="px-3 py-2 text-right">Visitas a su ficha</th>
                          <th scope="col" class="px-3 py-2 text-right">Clics a su web</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-niebla">
                        {medicionesSocio.map((m) => (
                          <tr>
                            <td class="px-3 py-2">{mesLabel(m.mes)}</td>
                            <td class="px-3 py-2 text-right font-semibold text-tinta">{m.visitas_ficha}</td>
                            <td class="px-3 py-2 text-right font-semibold text-tinta">{m.clics_web}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </section>
            )}

            <section aria-labelledby="socios">
              <h2 id="socios" class="font-display text-xl text-tinta">Socios</h2>
              <nav aria-label="Filtro por estado" class="mt-3 flex flex-wrap gap-2 text-sm">
                {["", ...ESTADOS_SOCIO].map((e) => (
                  <a
                    href={e ? `?estado=${e}` : Astro.url.pathname}
                    class:list={[
                      "rounded-full border px-4 py-1.5",
                      filtroEstado === e
                        ? "border-terracota bg-terracota/10 font-semibold text-tinta"
                        : "border-niebla text-piedra hover:border-terracota",
                    ]}
                  >
                    {e ? label(e) : "Todos"}
                  </a>
                ))}
              </nav>
              <div class="mt-4 overflow-x-auto rounded-xl border border-niebla">
                <table class="w-full min-w-[52rem] text-left text-sm">
                  <thead class="bg-arena/60 text-xs uppercase tracking-wide text-piedra-suave">
                    <tr>
                      <th scope="col" class="px-3 py-2">Socio</th>
                      <th scope="col" class="px-3 py-2">Tipo</th>
                      <th scope="col" class="px-3 py-2">Relación</th>
                      <th scope="col" class="px-3 py-2">Modelo vigente</th>
                      <th scope="col" class="px-3 py-2 text-right">Precio/año</th>
                      <th scope="col" class="px-3 py-2 text-right">Cobrado {resumen.anyo}</th>
                      <th scope="col" class="px-3 py-2 text-right">Clics · {mesLabel(resumen.mesPasado)}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-niebla">
                    {filas.map((f) => (
                      <tr class="align-top">
                        <td class="px-3 py-2.5">
                          <a href={`?socio=${f.id}`} class="font-medium text-arcilla underline decoration-niebla underline-offset-2 hover:decoration-terracota">
                            {f.nombre}
                          </a>
                        </td>
                        <td class="px-3 py-2.5 text-piedra-suave">{label(f.tipo)}</td>
                        <td class="px-3 py-2.5">{label(f.estado)}</td>
                        <td class="px-3 py-2.5">{f.modelo ? label(f.modelo) : "—"}</td>
                        <td class="px-3 py-2.5 text-right">{f.precioAnualCents > 0 ? formatEuros(f.precioAnualCents) : "—"}</td>
                        <td class={`px-3 py-2.5 text-right ${f.cobradoAnyoCents > 0 ? "font-semibold text-tinta" : "text-niebla"}`}>
                          {formatEuros(f.cobradoAnyoCents)}
                        </td>
                        <td class={`px-3 py-2.5 text-right ${f.clicsMesPasado > 0 ? "font-semibold text-tinta" : "text-niebla"}`}>
                          {f.clicsMesPasado}
                        </td>
                      </tr>
                    ))}
                    {filas.length === 0 && (
                      <tr>
                        <td colspan="7" class="px-3 py-6 text-center text-piedra-suave">
                          Sin socios{filtroEstado ? ` en estado «${label(filtroEstado)}»` : ""} todavía.
                          Carga el seed del Excel (docs/PANEL-SOCIOS-DINERO.md §4).
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>

            <section aria-labelledby="foto" class="rounded-xl border border-niebla p-4">
              <h2 id="foto" class="font-display text-lg text-tinta">Foto mensual</h2>
              <div class="mt-2 flex flex-wrap items-center gap-4">
                <form method="POST">
                  <input type="hidden" name="accion" value="snapshot" />
                  <input type="hidden" name="mes" value={mesFoto} />
                  <button type="submit" class="rounded-md bg-arcilla px-4 py-2 text-sm font-semibold text-crema hover:bg-terracota">
                    Hacer la foto de {mesLabel(mesFoto)}
                  </button>
                </form>
                <p class="text-sm text-piedra-suave">
                  Se hace sola el día 2 de cada mes.
                  {ultimaFoto ? ` Última foto: ${ultimaFoto.slice(0, 10)}.` : " Aún no hay ninguna foto."}
                </p>
              </div>
            </section>
          </div>
        )
      }
    </main>
  </body>
</html>
