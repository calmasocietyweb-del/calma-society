---
// Artículo en español: /articulo/[slug]
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articleSlugFor } from "../../lib/content";
import { articleUrl, homePath } from "../../i18n/utils";

// Componentes que el cuerpo MDX puede usar. Fuente ÚNICA para los seis
// idiomas: antes cada ruta tenía su copia y habían derivado (ver el fichero).
import { mdxComponents } from "../../components/mdxComponents";

export async function getStaticPaths() {
  const arts = await getCollection(
    "articulos",
    (e) => e.data.lang === "es" && e.data.status === "published",
  );
  return arts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const author = await getEntry(entry.data.author);
const relatedPlaces = entry.data.relatedPlaces
  ? await Promise.all(entry.data.relatedPlaces.map((ref) => getEntry(ref)))
  : [];

const enSlug = await articleSlugFor(entry.data.translationKey, "en");
const frSlug = await articleSlugFor(entry.data.translationKey, "fr");
const deSlug = await articleSlugFor(entry.data.translationKey, "de");
const itSlug = await articleSlugFor(entry.data.translationKey, "it");
const ptSlug = await articleSlugFor(entry.data.translationKey, "pt");
const alternates = {
  es: articleUrl("es", entry.id),
  en: enSlug ? articleUrl("en", enSlug) : homePath("en"),
  ...(frSlug ? { fr: articleUrl("fr", frSlug) } : {}),
  ...(deSlug ? { de: articleUrl("de", deSlug) } : {}),
  ...(itSlug ? { it: articleUrl("it", itSlug) } : {}),
  ...(ptSlug ? { pt: articleUrl("pt", ptSlug) } : {}),
};
---

<ArticleLayout entry={entry} author={author} relatedPlaces={relatedPlaces} alternates={alternates}>
  <Content components={mdxComponents} />
</ArticleLayout>
