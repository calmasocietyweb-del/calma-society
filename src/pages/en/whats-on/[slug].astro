---
// Event detail in English: /en/whats-on/[slug] (KAN-102).
import { getCollection } from "astro:content";
import EventLayout from "../../../layouts/EventLayout.astro";
import { eventSlugFor } from "../../../lib/content";
import { eventUrl, homePath } from "../../../i18n/utils";

export async function getStaticPaths() {
  const events = await getCollection(
    "eventos",
    (e) => e.data.lang === "en" && e.data.status === "published",
  );
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const esSlug = await eventSlugFor(entry.data.translationKey, "es");
const alternates = {
  en: eventUrl("en", entry.id),
  es: esSlug ? eventUrl("es", esSlug) : homePath("es"),
};
---

<EventLayout entry={entry} alternates={alternates} />
