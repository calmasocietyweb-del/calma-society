---
// Portadas de sección en portugués: /pt/descobrir, /pt/agenda, /pt/comer-e-beber, …
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionView from "../../components/SectionView.astro";
import { SECTIONS, getSection } from "../../config/sections";

export async function getStaticPaths() {
  return SECTIONS.map((s) => ({
    params: { section: s.href.pt.replace(/^\/pt\//, "") },
    props: { key: s.key },
  }));
}

const { key } = Astro.props;
const section = getSection(key)!;
const alternates = {
  es: section.href.es,
  en: section.href.en,
  fr: section.href.fr,
  de: section.href.de,
  it: section.href.it,
  pt: section.href.pt,
};
---

<BaseLayout
  title={section.seoTitle?.pt ?? section.label.pt}
  description={section.seoDescription?.pt ?? section.intro.pt}
  locale="pt"
  alternates={alternates}
>
  <SectionView sectionKey={key} locale="pt" />
</BaseLayout>
