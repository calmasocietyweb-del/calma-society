---
// "Planeie a sua viagem a Menorca" (PT-PT) — planeador de itinerários.
// SEO: além do plano interativo (renderizado no cliente, invisível aos
// crawlers), a página publica itinerários ESTÁTICOS de exemplo e uma FAQ
// (PlannerSeoContent) dirigidos a "o que fazer em Menorca", "itinerário
// Menorca", "Menorca em 5 dias".
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlannerView from "../../components/PlannerView.astro";
import PlannerSeoContent from "../../components/PlannerSeoContent.astro";

const alternates = {
  es: "/planificador",
  en: "/en/trip-planner",
  fr: "/fr/planificateur",
  de: "/de/reiseplaner",
  it: "/it/pianificatore-di-viaggio",
  pt: "/pt/planeador-de-viagem",
};
---

<BaseLayout
  title="O que fazer em Menorca: 3, 5 ou 7 dias"
  description="O que fazer em Menorca, dia a dia: o planeador constrói o seu itinerário por proximidade e sem pressa — enseadas, mesas escolhidas com critério e um plano B se o tempo virar."
  locale="pt"
  alternates={alternates}
>
  <div class="mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-16 print:hidden">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">Calma Society · Menorca</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">Planeie a sua viagem a Menorca</h1>
    <p class="lead mt-5">
      Um guia dia a dia, encadeado por proximidade e sem pressa: a ilha ao seu ritmo, com o
      critério do luxo tranquilo.
    </p>
    <p class="mt-5 text-base leading-relaxed text-piedra-suave">
      Menorca é uma <strong>espinha de peixe</strong>: tudo depende do eixo Maó–Ciutadella e as
      enseadas são as ramificações. O erro é ziguezaguear. Propomos-lhe um plano que agrupa por
      zonas, sai cedo para as enseadas, deixa margem para o vento e prevê um plano B em caso de
      mau tempo. Ajusta-o a seu gosto; a decisão final é sempre sua.
    </p>
  </div>

  <div class="mt-8">
    <PlannerView locale="pt" />
  </div>

  {/* Itinerários estáticos de exemplo + FAQ (SEO/GEO: conteúdo real indexável). */}
  <PlannerSeoContent locale="pt" />
</BaseLayout>
