---
// Página propia de la newsletter (PT). La captación = KPI nº1 (CLAUDE.md §3.1).
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { SITE } from "../../config/site";

const alternates = {
  es: "/newsletter",
  en: "/en/newsletter",
  fr: "/fr/newsletter",
  de: "/de/newsletter",
  it: "/it/newsletter",
  pt: "/pt/newsletter",
};

const benefits = [
  "Uma seleção do melhor de Menorca — com critério, sem enchimento.",
  "Recomendações em primeira mão: enseadas serenas, boas mesas, uma agenda de verdade.",
  "Histórias da ilha nos 365 dias do ano, época baixa incluída.",
];
---

<BaseLayout
  title="Newsletter — junte-se à Society"
  description="Subscreva a Calma Society: de quinze em quinze dias, o melhor de Menorca com um olhar de luxo tranquilo."
  locale="pt"
  alternates={alternates}
>
  <section class="mx-auto max-w-prosa px-5 pt-12 text-center sm:px-8 sm:pt-20">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">Newsletter</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">
      A ilha, na sua caixa de correio
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-piedra-suave">
      O capital da Calma Society não é o ruído: é a confiança. Junte-se a uma comunidade que
      prefere a qualidade à quantidade.
    </p>

    <ul class="mx-auto mt-8 max-w-md space-y-3 text-left">
      {
        benefits.map((b) => (
          <li class="flex gap-3 text-sm leading-relaxed text-piedra">
            <span aria-hidden="true" class="text-oro">—</span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    SITE.newsletter.enabled || SITE.newsletter.capture.enabled ? (
      <div class="mt-14">
        <NewsletterSignup origen="pagina-newsletter" umamiEvent="newsletter-submit-pagina-newsletter" />
      </div>
    ) : (
      <p class="mx-auto mt-12 max-w-prosa px-5 text-center text-piedra-suave sm:px-8">
        Estamos a prepará-la, sem pressa. <strong class="text-piedra">Muito em breve</strong> poderá subscrever.
      </p>
    )
  }
</BaseLayout>
