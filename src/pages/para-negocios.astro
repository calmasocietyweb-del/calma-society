---
// Para negocios (ES) — puerta de entrada de los negocios de la isla.
// Deliberadamente sobria: no es una página de venta y no lleva tarifa. La
// ficha es gratuita y editorial en esta fase (NEGOCIO/CAPTACION-EMPRESAS.md).
import BaseLayout from "../layouts/BaseLayout.astro";
import BusinessForm from "../components/BusinessForm.astro";
import { useTranslations } from "../i18n/ui";
import { businessPath } from "../i18n/utils";

const t = useTranslations("es");
const alternates = {
  es: businessPath("es"),
  en: businessPath("en"),
  fr: businessPath("fr"),
  de: businessPath("de"),
};
---

<BaseLayout
  title={t("business.title")}
  description="Tu negocio de Menorca en Calma Society: ficha editorial gratuita con foto, criterio, tus datos y enlace a tu web. El puesto y la opinión no se compran."
  locale="es"
  alternates={alternates}
>
  <section class="mx-auto max-w-prosa px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">{t("business.nav")}</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">{t("business.title")}</h1>
    <p class="mt-5 text-lg leading-relaxed text-piedra-suave">{t("business.lead")}</p>

    <div class="mt-8 border border-niebla bg-arena/50 px-6 py-5">
      <h2 class="font-display text-xl text-tinta">{t("business.rules.title")}</h2>
      <p class="mt-2 text-[15px] leading-relaxed text-piedra">{t("business.rules.body")}</p>
    </div>

    <div class="mt-10">
      <BusinessForm />
    </div>
  </section>
</BaseLayout>
