---
// Pour les professionnels (FR) — ver la nota de `para-negocios.astro`.
// Existe en FR porque las fichas de lugar también existen en FR y enlazan aquí.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BusinessForm from "../../components/BusinessForm.astro";
import { useTranslations } from "../../i18n/ui";
import { businessPath } from "../../i18n/utils";

const t = useTranslations("fr");
const alternates = {
  es: businessPath("es"),
  en: businessPath("en"),
  fr: businessPath("fr"),
  de: businessPath("de"), it: businessPath("it"),
  pt: businessPath("pt"),
};
---

<BaseLayout
  title={t("business.title")}
  description="Votre établissement de Minorque dans Calma Society : une fiche éditoriale gratuite avec photo, point de vue, vos coordonnées et le lien vers votre site. La place et l’avis ne sont pas à vendre."
  locale="fr"
  alternates={alternates}
>
  <section class="mx-auto max-w-prosa px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">{t("business.nav")}</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">{t("business.title")}</h1>
    <p class="mt-5 text-lg leading-relaxed text-piedra-suave">{t("business.lead")}</p>

    <div class="mt-8 border border-niebla bg-arena/50 px-6 py-5">
      <h2 class="font-display text-xl text-tinta">{t("business.rules.title")}</h2>
      <p class="mt-2 text-[15px] leading-relaxed text-piedra">{t("business.rules.body")}</p>
    </div>

    <div class="mt-10">
      <BusinessForm />
    </div>
  </section>
</BaseLayout>
