---
// Pagina della newsletter (IT). La captación = KPI nº1 (CLAUDE.md §3.1).
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { SITE } from "../../config/site";

const alternates = {
  es: "/newsletter",
  en: "/en/newsletter",
  fr: "/fr/newsletter",
  de: "/de/newsletter",
  it: "/it/newsletter",
  pt: "/pt/newsletter",
};

const benefits = [
  "Una selezione del meglio di Minorca — con criterio, senza riempitivi.",
  "Consigli di prima mano: cale tranquille, buone tavole, un'agenda vera.",
  "Storie dall'isola 365 giorni all'anno, bassa stagione compresa.",
];
---

<BaseLayout
  title="Newsletter — entri nella Society"
  description="Si iscriva a Calma Society: ogni due settimane il meglio di Minorca nel segno del lusso tranquillo."
  locale="it"
  alternates={alternates}
>
  <section class="mx-auto max-w-prosa px-5 pt-12 text-center sm:px-8 sm:pt-20">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-oro">Newsletter</p>
    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">
      L'isola, nella sua casella di posta
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-piedra-suave">
      Il capitale di Calma Society non è il rumore, è la fiducia. Entri a far parte di una
      comunità che preferisce la qualità alla quantità.
    </p>

    <ul class="mx-auto mt-8 max-w-md space-y-3 text-left">
      {
        benefits.map((b) => (
          <li class="flex gap-3 text-sm leading-relaxed text-piedra">
            <span aria-hidden="true" class="text-oro">—</span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    SITE.newsletter.enabled || SITE.newsletter.capture.enabled ? (
      <div class="mt-14">
        <NewsletterSignup origen="pagina-newsletter" umamiEvent="newsletter-submit-pagina-newsletter" />
      </div>
    ) : (
      <p class="mx-auto mt-12 max-w-prosa px-5 text-center text-piedra-suave sm:px-8">
        La stiamo preparando, senza fretta. <strong class="text-piedra">Molto presto</strong> potrà iscriversi.
      </p>
    )
  }
</BaseLayout>
