---
// Plantilla de DETALLE DE EVENTO (KAN-102): /agenda/[slug] y /en/whats-on/[slug].
// Antes las tarjetas de la agenda parecían clicables y no llevaban a nada; cada
// evento tiene ahora su página propia con fechas, lugar, web oficial, JSON-LD
// `Event` y captación de la Sociedad (el KPI nº1).
import { type CollectionEntry, getEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { useTranslations, experienceTypeLabel } from "../i18n/ui";
import { SITE, type Locale } from "../config/site";
import { articleUrl, eventUrl, placeUrl, homePath, formatDate } from "../i18n/utils";
import { getSection } from "../config/sections";
import { articleSlugFor, placeSlugFor, getUpcomingEvents } from "../lib/content";
import { abs, eventSchema, breadcrumbSchema } from "../lib/schema";
import { srcset } from "../lib/img";

interface Props {
  entry: CollectionEntry<"eventos">;
  alternates?: Partial<Record<Locale, string>>;
}
const { entry, alternates } = Astro.props;
const { data } = entry;
const locale = data.lang as Locale;
const t = useTranslations(locale);

// Breadcrumb hacia la portada de la agenda (la 2ª página más visitada).
const agenda = getSection("agenda")!;
const agendaHref = agenda.href[locale];
const agendaLabel = agenda.label[locale];

// ── Fechas por idioma (mismo criterio que EventCard: UTC, sin husos raros) ───
const startISO = data.startDate.toISOString().slice(0, 10);
const endISO = data.endDate?.toISOString().slice(0, 10);
const sameDay =
  data.endDate && data.endDate.toDateString() === data.startDate.toDateString();
const showRange = !!data.endDate && !sameDay;

// ── Lugar: si el evento referencia una ficha de `lugares`, se enlaza ─────────
// La referencia puede apuntar a la ficha de otro idioma; se resuelve la versión
// del idioma de la página vía translationKey. Solo fichas `published` (§6 bis).
let place: CollectionEntry<"lugares"> | null = null;
if (data.locationRef) {
  const referenced = await getEntry(data.locationRef);
  if (referenced && referenced.data.status === "published") {
    if (referenced.data.lang === locale) {
      place = referenced;
    } else {
      const sameLangId = await placeSlugFor(referenced.data.translationKey, locale);
      if (sameLangId) place = (await getEntry("lugares", sameLangId)) ?? null;
    }
  }
}
const locationName = place?.data.name ?? data.location;

// ── Artículos que dan contexto al evento (KAN-110) ───────────────────────────
// Mismo criterio que el lugar: se acepta una referencia en otro idioma y se
// resuelve la versión de esta página por translationKey; solo `published`
// (§6 bis). Si un artículo se despublica, desaparece del bloque sin romper la
// página — por eso se filtra en vez de confiar en el dato.
const related = (
  await Promise.all(
    (data.relatedArticles ?? []).map(async (ref) => {
      const referenced = await getEntry(ref);
      if (!referenced || referenced.data.status !== "published") return null;
      if (referenced.data.lang === locale) return referenced;
      const sameLangId = await articleSlugFor(referenced.data.translationKey, locale);
      return sameLangId ? ((await getEntry("articulos", sameLangId)) ?? null) : null;
    }),
  )
).filter((a): a is CollectionEntry<"articulos"> => a !== null);

// ── SEO + GEO (CLAUDE.md §8) ─────────────────────────────────────────────────
// Título único por idioma y anclado a "Menorca" (lección KAN-88: nada de
// <title> duplicados entre versiones de idioma).
const TITLE_SUFFIX: Record<Locale, string> = {
  es: "Agenda de Menorca",
  en: "What's on in Menorca",
  fr: "Agenda de Minorque",
  de: "Veranstaltungen auf Menorca",
};
const seoTitle = `${data.title} — ${TITLE_SUFFIX[locale]}`;

const canonical = abs(eventUrl(locale, entry.id));
const eventLd = eventSchema({
  title: data.title,
  description: data.description,
  startDate: data.startDate,
  endDate: data.endDate,
  location: locationName,
  url: canonical,
  image: data.image,
  geo: place ? { lat: place.data.coordinates.lat, lng: place.data.coordinates.lng } : undefined,
  sameAs: data.sourceUrl,
});
// ── Malla interna ENTRE eventos (continuación de KAN-102) ────────────────────
// Las páginas de detalle solo enlazaban hacia fuera; sin camino de rastreo
// entre ellas se repite el patrón de las fichas de lugares (rastreadas sin
// indexar en GSC hasta la malla "Cerca de aquí"). Tres citas siguientes por
// fecha, del mismo idioma; al final del calendario se completa con anteriores.
const upcoming = await getUpcomingEvents(locale, entry);

const breadcrumb = breadcrumbSchema([
  { name: SITE.name, url: abs(homePath(locale)) },
  { name: agendaLabel, url: abs(agendaHref) },
  { name: data.title, url: canonical },
]);
---

<BaseLayout
  title={seoTitle}
  description={data.description}
  locale={locale}
  alternates={alternates}
  image={data.image}
  imageAlt={data.title}
>
  <article class="mx-auto max-w-prosa px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    {/* Miga de pan visible hacia la agenda (además del BreadcrumbList JSON-LD). */}
    <nav aria-label={t("a11y.breadcrumb")} class="text-xs font-semibold uppercase tracking-widest">
      <a href={agendaHref} class="text-oro transition-colors hover:text-terracota">{agendaLabel}</a>
      <span aria-hidden="true" class="mx-1.5 text-niebla">/</span>
      <span class="text-piedra-suave">{experienceTypeLabel(data.category, locale)}</span>
    </nav>

    <h1 class="mt-3 font-display text-4xl text-tinta sm:text-5xl">{data.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-piedra-suave">{data.description}</p>

    {
      data.image && (
        <figure class="mt-8">
          <div class="aspect-[3/2] overflow-hidden rounded-xl bg-arena">
            <img
              src={data.image}
              srcset={srcset(data.image)}
              sizes="(min-width: 700px) 672px, 100vw"
              alt={data.imageAlt ?? data.title}
              width="1600"
              height="1067"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          {data.imageCredit && (
            <figcaption class="mt-2 text-xs text-piedra-suave">
              {t("common.photo")}: {data.imageCredit}
            </figcaption>
          )}
        </figure>
      )
    }

    {/* Cuándo y dónde: los datos concretos que la IA cita (GEO, CLAUDE.md §8). */}
    <section class="mt-10 rounded-xl border border-niebla bg-arena/30 p-6">
      <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        <div>
          <dt class="text-xs uppercase tracking-wide text-piedra-suave">{t("agenda.when")}</dt>
          <dd class="mt-0.5 text-sm text-piedra">
            <time datetime={startISO}>{formatDate(data.startDate, locale)}</time>
            {
              showRange && (
                <>
                  {" – "}
                  <time datetime={endISO}>{formatDate(data.endDate!, locale)}</time>
                </>
              )
            }
          </dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-piedra-suave">{t("agenda.where")}</dt>
          <dd class="mt-0.5 text-sm text-piedra">
            {
              place ? (
                <a
                  href={placeUrl(locale, place.id)}
                  class="border-b border-terracota pb-0.5 font-medium text-arcilla transition-colors hover:text-terracota"
                >
                  {place.data.name}
                </a>
              ) : (
                data.location
              )
            }
          </dd>
        </div>
      </dl>
    </section>

    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
      {
        data.sourceUrl && (
          <a
            href={data.sourceUrl}
            rel="noopener"
            target="_blank"
            data-umami-event="click-salida-evento"
            class="inline-block border-b border-terracota pb-0.5 text-sm font-medium text-arcilla hover:text-terracota"
          >
            {t("event.official")} →
          </a>
        )
      }
      <a
        href={agendaHref}
        class="inline-block border-b border-terracota pb-0.5 text-sm font-medium text-arcilla hover:text-terracota"
      >
        {t("event.all")} →
      </a>
    </p>

    {/* Para ir con contexto: los artículos que explican el pueblo, la tradición
        o el producto de este evento. Es el enlace que faltaba HACIA DENTRO —
        antes la única salida de la ficha era la web oficial, que se lleva al
        lector fuera. Lista sobria, sin foto: aquí manda el titular. */}
    {
      related.length > 0 && (
        <section aria-labelledby="related-articles" class="mt-14 border-t border-niebla pt-8">
          <h2 id="related-articles" class="font-display text-2xl text-tinta">
            {t("event.related")}
          </h2>
          <ul class="mt-6 space-y-5">
            {related.map((a) => (
              <li>
                <a href={articleUrl(locale, a.id)} class="group block">
                  <span class="font-display text-lg leading-snug text-tinta transition-colors duration-300 group-hover:text-terracota">
                    {a.data.title}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-piedra-suave">
                    {a.data.excerpt}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Próximas citas: variante ligera (sin foto) para el pie — fecha, título y
        tipo de experiencia con los tokens del sistema. Enlazado interno entre
        eventos: una razón para seguir navegando y un camino de rastreo. */}
    {
      upcoming.length > 0 && (
        <section aria-labelledby="upcoming-events" class="mt-14 border-t border-niebla pt-8">
          <h2 id="upcoming-events" class="font-display text-2xl text-tinta">
            {t("event.upcoming")}
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-3">
            {upcoming.map((e) => (
              <li>
                <a
                  href={eventUrl(locale, e.id)}
                  class="group flex h-full flex-col border border-niebla p-4 transition-colors duration-300 hover:border-terracota"
                >
                  <span class="text-[0.65rem] font-semibold uppercase tracking-widest text-oro">
                    {experienceTypeLabel(e.data.category, locale)}
                  </span>
                  <span class="mt-1.5 font-display text-lg leading-snug text-tinta transition-colors duration-300 group-hover:text-terracota">
                    {e.data.title}
                  </span>
                  <time
                    datetime={e.data.startDate.toISOString().slice(0, 10)}
                    class="mt-auto pt-3 text-sm text-piedra-suave"
                  >
                    {formatDate(e.data.startDate, locale)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  {/* Captación al pie (KPI nº1): mismo gancho honesto que la portada de agenda,
      con atribución propia por-origen para medir qué convierte (KAN-93). */}
  <NewsletterSignup
    variant="inline"
    eyebrow={t("newsletter.agenda.eyebrow")}
    title={t("newsletter.agenda.title")}
    text={t("newsletter.agenda.text")}
    origen="evento"
    umamiEvent="newsletter-submit-evento"
  />

  <JsonLd schema={[eventLd, breadcrumb]} />
</BaseLayout>
